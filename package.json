{
    "name": "sierra-estates",
    "version": "1.0.0",
    "private": true,
    "description": "Sierra Estates — Luxury PropTech Platform for New Cairo",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "dev": "turbo run dev",
        "build": "turbo run build",
        "lint": "turbo run lint",
        "type-check": "turbo run type-check",
        "fetch:real-data": "node apps/sierra-estates-realty/scripts/fetch-real-data.mjs",
        "test:ci": "turbo run test:ci",
        "clean": "turbo run clean && rm -rf node_modules",
        "link:vercel": "vercel link",
        "deploy:preview": "vercel --build-env NEXT_PUBLIC_APP_ENV=preview",
        "deploy:prod": "vercel --prod",
        "deploy:firebase": "firebase deploy --only firestore:rules,storage,functions",
        "vertex-agent": "npx ts-node --transpile-only scripts/vertex-agent-runner.ts"
    },
    "devDependencies": {
        "@openai/codex-security": "^0.1.4",
        "turbo": "^2.3.3",
        "typescript": "^5.8.2",
        "vitest": "^4.1.10"
    },
    "dependencies": {
        "@vercel/speed-insights": "^2.0.0"
    },
    "engines": {
        "node": ">=22.0.0",
        "pnpm": ">=9"
    },
    "packageManager": "pnpm@9.15.4",
    "_comment_pnpm_overrides": "ACTIVE overrides for pnpm 9 (the pinned major) — this is what pnpm-lock.yaml records. pnpm 10+ reads `overrides:` in pnpm-workspace.yaml instead; keep the two in sync. See the header comment above that block before changing either.",
    "pnpm": {
        "overrides": {
            "esbuild@<=0.24.2": ">=0.25.0",
            "postcss@<8.5.10": ">=8.5.10",
            "uuid@<11.1.1": ">=11.1.1",
            "sharp@<0.35.0": ">=0.35.0",
            "postcss@<=8.5.11": ">=8.5.12",
            "postcss@<=8.5.17": ">=8.5.18",
            "postcss@<=8.5.22": ">=8.5.23",
            "fast-uri@>=3.0.0 <3.1.5": ">=3.1.5",
            "js-yaml@>=4.0.0 <4.3.1": ">=4.3.1",
            "pdfjs-dist@>=5.6.83 <6.2.108": ">=6.2.108",
            "react-router@>=7.12.0 <7.18.2": ">=7.18.2"
        }
    }
}
