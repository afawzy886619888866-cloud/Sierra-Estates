# OpenWA gateway runtime configuration (generated by services/openwa/setup.sh)
# See the upstream README for every knob: https://github.com/rmyndharis/OpenWA

# ── HTTP API + bundled dashboard ─────────────────────────────────────────────
PORT=2785
HOST=0.0.0.0

# ── Authentication ───────────────────────────────────────────────────────────
# Bootstrap convenience ONLY: seeds the well-known "dev-admin-key" so you can
# log into the dashboard and create a REAL admin API key on first run.
# After creating your real key, set ALLOW_DEV_API_KEY=false and restart.
ALLOW_DEV_API_KEY=true

# Recommended: set your real keys here once created (dashboard → API Keys).
# API_KEYS=key-id-1:sk-live-xxxxxxxx,key-id-2:sk-other-yyyy
API_KEYS=

# ── Persistence ──────────────────────────────────────────────────────────────
# Session data (QR pairing, credentials) must survive restarts — mount/persist
# this directory, or you will re-scan the QR after every deploy.
DATA_DIR=./data

# ── Logging / metrics ────────────────────────────────────────────────────────
LOG_LEVEL=info
# METRICS_TOKEN=change-me-if-you-scrape-/api/metrics
