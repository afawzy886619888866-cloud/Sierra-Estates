# =====================================================
# free-claude-code (claude-proxy) — Environment Variables
# Copy to .env and fill in values.
# NEVER commit .env to version control.
#
# This file mirrors config/settings.py's Settings model — it is also the
# packaging forced-include referenced by pyproject.toml
# ([tool.hatch.build.targets.wheel.force-include]), so `hatch build` /
# `uv build` need it present even with every value left blank.
# =====================================================

# ─── Provider API keys (leave blank to disable a provider) ───
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
CODESTRAL_API_KEY=
DEEPSEEK_API_KEY=
KIMI_API_KEY=
WAFER_API_KEY=
OPENCODE_API_KEY=
ZAI_API_KEY=
FIREWORKS_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=

# ─── NVIDIA NIM ───
NVIDIA_NIM_API_KEY=

# ─── Local model servers ───
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LLAMACPP_BASE_URL=http://localhost:8080/v1
# Root URL only — no /v1 suffix.
OLLAMA_BASE_URL=http://localhost:11434

# ─── Default model routing ───
# Format: provider_type/model/name
MODEL=nvidia_nim/z-ai/glm4.7
MODEL_OPUS=
MODEL_SONNET=
MODEL_HAIKU=

# ─── Per-provider outbound proxy (optional) ───
NVIDIA_NIM_PROXY=
OPENROUTER_PROXY=
MISTRAL_PROXY=
CODESTRAL_PROXY=
LMSTUDIO_PROXY=
LLAMACPP_PROXY=
KIMI_PROXY=
WAFER_PROXY=
OPENCODE_PROXY=
OPENCODE_GO_PROXY=
ZAI_PROXY=
FIREWORKS_PROXY=
GEMINI_PROXY=
GROQ_PROXY=
CEREBRAS_PROXY=

# ─── Provider rate limiting ───
PROVIDER_RATE_LIMIT=40
PROVIDER_RATE_WINDOW=60
PROVIDER_MAX_CONCURRENCY=5

# ─── Extended thinking (ENABLE_MODEL_THINKING is the fallback for the 3 per-tier flags) ───
ENABLE_MODEL_THINKING=true
ENABLE_OPUS_THINKING=
ENABLE_SONNET_THINKING=
ENABLE_HAIKU_THINKING=

# ─── HTTP client timeouts (seconds) ───
HTTP_READ_TIMEOUT=120.0
HTTP_WRITE_TIMEOUT=10.0
HTTP_CONNECT_TIMEOUT=

# ─── Local web server tools (web_search / web_fetch) ───
# Off by default: these make outbound HTTP from the proxy (SSRF risk).
ENABLE_WEB_SERVER_TOOLS=false
WEB_FETCH_ALLOWED_SCHEMES=http,https
WEB_FETCH_ALLOW_PRIVATE_NETWORKS=false

# ─── Debug / diagnostic logging (avoid enabling in shared environments) ───
LOG_RAW_API_PAYLOADS=false
LOG_RAW_SSE_EVENTS=false
LOG_API_ERROR_TRACEBACKS=false
LOG_RAW_MESSAGING_CONTENT=false
LOG_RAW_CLI_DIAGNOSTICS=false
LOG_MESSAGING_ERROR_DETAILS=false
DEBUG_PLATFORM_EDITS=false
DEBUG_SUBAGENT_STACK=false

# ─── Voice note transcription ───
VOICE_NOTE_ENABLED=true
# "cpu" | "cuda" | "nvidia_nim"
WHISPER_DEVICE=cpu
WHISPER_MODEL=base
HF_TOKEN=

# ─── Messaging bot wrapper (Telegram / Discord) ───
MESSAGING_PLATFORM=discord
MESSAGING_RATE_LIMIT=1
MESSAGING_RATE_WINDOW=1.0
TELEGRAM_BOT_TOKEN=
ALLOWED_TELEGRAM_USER_ID=
DISCORD_BOT_TOKEN=
ALLOWED_DISCORD_CHANNELS=
MAX_MESSAGE_LOG_ENTRIES_PER_CHAT=

# ─── Server ───
# Optional API key to protect endpoints (Anthropic-style header). Empty = no auth required.
ANTHROPIC_AUTH_TOKEN=
