{
    "name": "sierra-estates-client-page",
    "version": "1.0.1",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "prebuild": "node scripts/ensure-snapshot.mjs && node scripts/apply-pending-migrations.mjs",
        "build": "npm run prebuild && npm run type-check && cross-env NODE_OPTIONS=--max-old-space-size=4096 next build --webpack",
        "start": "next start",
        "lint": "eslint . && node scripts/validate-configs.mjs",
        "type-check": "node scripts/ensure-snapshot.mjs && cross-env NODE_OPTIONS=--max-old-space-size=4096 tsc --noEmit",
        "fix-build": "rimraf .next && npm run build",
        "check-node": "node scripts/diagnostic.mjs",
        "seed:admin": "node scripts/seed-admin.mjs",
        "inventory:snapshot": "node scripts/generate-inventory-snapshot.mjs",
        "test": "jest --testPathPatterns=__tests__",
        "test:ci": "jest --ci --coverage --forceExit --maxWorkers=2 --testPathPatterns=__tests__"
    },
