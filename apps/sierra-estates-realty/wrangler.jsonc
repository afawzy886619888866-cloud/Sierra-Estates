{
  // Unified Cloudflare Worker config for Sierra Estates (@opennextjs/cloudflare).
  // Single project (`sierra-estates`) serves all 3 custom domains via host rewrites:
  //   - sierra-estates.net       (Client Portal)
  //   - www.sierra-estates.net   (Client Portal)
  //   - admin.sierra-estates.net (Admin OS -> /admin, protected by Zero Trust Access)
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "sierra-estates",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "minify": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
