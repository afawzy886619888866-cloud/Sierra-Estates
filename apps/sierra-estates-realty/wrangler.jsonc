{
  // Cloudflare Worker config for the Sierra Estates Next.js app
  // (@opennextjs/cloudflare). The deploy workflow (deploy-cloudflare.yml)
  // overrides the worker NAME per matrix role with --name:
  //   client -> sierra-estates      (custom domain: sierra-estates.net, www.sierra-estates.net)
  //   admin  -> sierra-estates88    (custom domain: admin.sierra-estates.net)
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "sierra-estates",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
