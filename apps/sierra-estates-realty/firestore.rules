rules_version = '2';

// ============================================================================
// Sierra Estates — Firestore Security Rules (CANONICAL — deployed via firebase.json)
//
// Model: "staff" = a signed-in user whose users/{uid} document has
//   role ∈ {admin, manager, agent}. Mirrors how the app resolves roles
//   (lib/AuthContext.tsx reads users/{uid}.role) and the backend
//   verifyAdminRequest. This REPLACES the legacy admins/{uid} model.
//
// Privileged server operations use the Firebase Admin SDK, which BYPASSES these
// rules — so locking the client down here does not affect API routes / cron.
//
// Rules use OR semantics: the broad `/{document=**}` staff rule grants staff
// access everywhere; the specific matches ADD narrower public access on top
// (public catalog reads, public share-link reads + constrained analytics writes).
//
// ⚠️ BEFORE DEPLOYING (firebase deploy --only firestore:rules):
//   1. Every staff member MUST have a users/{uid} doc with role ∈
//      {admin,manager,agent}, else they lose dashboard access.
//   2. Run the emulator rules tests (see PR) — the constrained-update rules
//      below must be verified against the actual client payloads.
//   3. Roll back by redeploying the previous file if anything is locked out.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isStaff() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'manager', 'agent'];
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // --- Public marketplace catalog: anyone may read; only staff may write ---
    match /listings/{id}    { allow read: if true;  allow write: if isStaff(); }
    match /units/{id}       { allow read: if true;  allow write: if isStaff(); }
    match /properties/{id}  { allow read: if true;  allow write: if isStaff(); }
    match /projects/{id}    { allow read: if true;  allow write: if isStaff(); }
    match /developers/{id}  { allow read: if true;  allow write: if isStaff(); }
    match /mediaAssets/{id} { allow read: if true;  allow write: if isStaff(); }
    match /media/{id}       { allow read: if true;  allow write: if isStaff(); }
    match /zones/{id}       { allow read: if true;  allow write: if isStaff(); }

    // --- Client portal collections (sierra-estates.net) ---
    //     The static client portal (firebase-data.js) reads houyez_listings +
    //     houyez_compounds publicly, and its contact/career forms create
    //     inquiries + careers anonymously. Without these, the portal silently
    //     falls back to static data and leads never reach Firestore / Laila bot.
    match /houyez_listings/{id}  { allow read: if true;  allow write: if isStaff(); }
    match /houyez_compounds/{id} { allow read: if true;  allow write: if isStaff(); }
    // Writes arrive via the Admin SDK in app/api/inquiries/route.ts and
    // app/api/careers/apply/route.ts, which enforce zod validation and a 24 KB
    // body cap. An anonymous `allow create` here bypasses both, and matched a
    // payload shape nothing produces: the inquiries API writes status
    // 'S1_NEW_LEAD' (not 'new'), and career applications are written to
    // `career_applications`, not `careers`. Verified: no client-SDK or static
    // page writes to either collection. Re-add only alongside a real
    // client-side writer, and gate it on that writer's actual payload.
    match /inquiries/{id} {
      allow read, write: if isStaff();
    }
    match /careers/{id} {
      allow read, write: if isStaff();
    }

    // --- Share links. `allow read: if true` on a wildcard document match
    //     authorises LIST queries over the whole collection, not just direct
    //     gets, so it exposed every client name and deal price to anyone
    //     holding the public web API key. The client pages it was written for
    //     (app/proposals/[id]/page.tsx, app/concierge/[leadId]/page.tsx) do not
    //     exist. Serve public share links through an Admin SDK route instead.
    //     Analytics writes stay open so an unauthenticated viewer can still be
    //     counted if those pages return. ---
    match /proposals/{id} {
      allow get: if true;
      allow list: if isStaff();
      allow update: if isStaff()
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount', 'lastViewedAt'])
            && request.resource.data.viewCount is int
            && request.resource.data.lastViewedAt is timestamp);
      allow create, delete: if isStaff();
    }
    match /concierge_selections/{id} {
      allow get: if true;
      allow list: if isStaff();
      allow update: if isStaff()
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['engagement'])
            && request.resource.data.engagement is map);
      allow create, delete: if isStaff();
    }

    // --- Users: a user may read their own profile; writes are constrained ---
    // Staff may update user docs, but NOBODY may change the `role` field on
    // their OWN document — that would be self privilege-escalation (an agent
    // promoting itself to admin). Provisioning and removal are admin-only;
    // server-side provisioning uses the Admin SDK, which bypasses these rules.
    match /users/{uid} {
      allow read:   if isSignedIn() && (request.auth.uid == uid || isStaff());
      allow update: if isStaff()
        && (request.auth.uid != uid
            || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']));
      allow create, delete: if isAdmin();
    }

    // --- Audit trail: append-only from the server. Staff (including agents)
    //     must never be able to rewrite or delete their own audit trail from
    //     the client. The Admin SDK bypasses these rules, so the server-side
    //     audit writes in app/api/admin/* keep working. Admins may read for
    //     review; everyone else goes through the /api/admin/audit route. ---
    match /audit_logs/{document=**} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    // --- AI Engine & Multi-Agent Orchestrator (engine_memory, engine_memory_audit, ai_workflow_results, propertyfinder_sync) ---
    match /engine_memory/{id} {
      allow read, write: if isStaff();
    }
    match /engine_memory_audit/{id} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if false; // Immutable audit log
    }
    match /ai_workflow_results/{id} {
      allow read, write: if isStaff();
    }
    match /propertyfinder_sync/{id} {
      allow read, write: if isStaff();
    }

    // --- Everything else (leads, deals, sales, viewings, vouchers, activities,
    //     intelligence, strategic_pipeline, agents, workflows, syncQueue, … )
    //     — staff only.
    //
    //     Rules use OR semantics: a narrower match can only ADD access, never
    //     subtract it. So any collection that must be MORE restricted than
    //     "any staff member" has to be excluded from this catch-all by name —
    //     otherwise the `users` and `audit_logs` rules above would be
    //     silently overridden by it. ---
    match /{collection}/{document=**} {
      allow read, write: if isStaff()
        && !(collection in ['users', 'audit_logs']);
    }
  }
}
