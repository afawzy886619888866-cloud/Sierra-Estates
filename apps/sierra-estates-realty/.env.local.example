# ══════════════════════════════════════════════════════════════════════════════
# SIERRA ESTATES — VERCEL ENVIRONMENT VARIABLES
# ══════════════════════════════════════════════════════════════════════════════
# INSTRUCTIONS:
# 1. Fill in all the values marked with "your-..." below.
# 2. Go to Vercel -> Your Project -> Settings -> Environment Variables.
# 3. Copy ALL the text in this file and paste it into the FIRST "Key" input box. 
#    Vercel will automatically parse all the variables for you.
# 4. Do this for BOTH projects (Client and Admin).

# --- Supabase Project Configuration ---
# Migrated from Firebase on 2026-09-20. Get all values from:
#   Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key

# Server-only — DO NOT expose to the browser:
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_ACCESS_TOKEN=sbp_your_supabase_access_token

# Postgres (Supabase connection pooler) — used by Prisma / direct pg client
POSTGRES_URL=postgresql://postgres.your-project-ref:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
POSTGRES_URL_NON_POOLING=postgresql://postgres.your-project-ref:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
POSTGRES_USER=postgres
POSTGRES_HOST=db.your-project-ref.supabase.co
POSTGRES_PASSWORD=your-database-password
POSTGRES_DATABASE=postgres

# Storage buckets (must exist in Supabase -> Storage)
SUPABASE_MEDIA_BUCKET=media
SUPABASE_PROPERTY_MEDIA_BUCKET=property-media

# --- Third-Party Integrations ---
PROPERTY_FINDER_API_KEY=your-property-finder-api-key
PROPERTY_FINDER_API_SECRET=your-property-finder-api-secret
PF_API_KEY=your-property-finder-api-key
PF_API_SECRET=your-property-finder-api-secret

SBR_SECRET_KEY=your-sbr-secret-key
CRON_SECRET=your-cron-secret
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=your-telegram-bot-username
SENDGRID_API_KEY=your-sendgrid-api-key
SENDER_EMAIL=noreply@sierraestatesrealty.com

# --- AI & LLM ---
GOOGLE_AI_API_KEY=your-google-ai-api-key
GEMINI_API_KEY=your-google-ai-api-key

# --- AWS ---
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1

# --- Security ---
SESSION_SECRET=your-session-secret

# --- Application Settings ---
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_APP_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,https://sierra-estates.net,https://admin.sierra-estates.net

# Intelligence OS console (Remix app on Cloud Run) — embedded in /admin/intelligence-os.
NEXT_PUBLIC_INTELLIGENCE_OS_URL=https://remix-remix-remix-sierra-estates-intelligence-os-755638710103.europe-west2.run.app

# Telegram webhook verification (set the same value as secret_token in setWebhook)
TELEGRAM_WEBHOOK_SECRET=

# Agency/owner WhatsApp number (E.164, e.g. +201234567890) that receives a
# WhatsApp notification whenever a new lead is submitted via /api/leads.
LEAD_NOTIFY_WHATSAPP_NUMBER=

# --- WhatsApp Gateway (OpenWA on AWS EC2) — REQUIRED for gateway features ---
# No hardcoded fallbacks: features return 503 "not_configured" until set.
OPENWA_HOST=your-openwa-gateway-host
OPENWA_PORT=3000
OPENWA_ADMIN_API_KEY=your-openwa-admin-api-key
OPENWA_SESSION_ID=your-openwa-session-id
WHATSAPP_GATEWAY_HOST=your-openwa-gateway-host

# --- Admin Access Control ---
# Comma-separated admin email allowlist (server-side only). Wildcard domains allowed
# ONLY for domains you own, e.g. "you@yourdomain.com,@yourdomain.com".
ADMIN_EMAILS=admin@sierra-estates.net

# --- App Attestation (guards /api/openclaw LLM-spend endpoints) ---
APP_CHECK_SECRET=your-app-check-secret

# --- Bootstrap (first superadmin login) ---
ADMIN_BOOTSTRAP_PASSWORD=change-me-immediately
