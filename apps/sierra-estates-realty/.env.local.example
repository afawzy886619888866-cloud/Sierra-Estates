# Sierra Estates app-local environment template
# Copy this file to .env.local and fill in values locally.
# Never commit .env.local or real credentials.
#
# Supabase is the sole authoritative backend for Auth, database, and Storage.
# Property media is stored in the public `property-media` bucket.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://gaxfqcietzoonlmatiot.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_PROPERTY_MEDIA_BUCKET=property-media
SUPABASE_MEDIA_BUCKET=media

# Application URLs and browser-safe routing
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CLIENT_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3000/admin
NEXT_PUBLIC_DEFAULT_LOCALE=en
ALLOWED_ORIGINS=http://localhost:3000
COOKIE_DOMAIN=

# Server-side session and request authentication live in the root
# .env.example. Do not copy server credentials into this app-local template.
ADMIN_EMAILS=admin@sierra-estates.net

# Notifications and messaging
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
LEAD_NOTIFY_WHATSAPP_NUMBER=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
# Self-hosted OpenWA gateway (github.com/rmyndharis/OpenWA) — outbound transport.
# Full runbook: services/openwa/README.md
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
OPENWA_SESSION_ID=session-default

# AI integrations
GOOGLE_AI_API_KEY=
GOOGLE_GENAI_API_KEY=
AI_PROVIDER=
GOOGLE_CLOUD_LOCATION=europe-west1

# Inventory and worker integrations
INVENTORY_SHEET_ID=
INVENTORY_SHEET_GID=
MASTER_SHEET_ID=
N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=

# Optional shared services
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
NEXT_PUBLIC_INTELLIGENCE_OS_URL=
