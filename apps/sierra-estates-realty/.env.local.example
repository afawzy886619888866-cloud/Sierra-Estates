# ══════════════════════════════════════════════════════════════════════════════
# SIERRA ESTATES — VERCEL ENVIRONMENT VARIABLES
# ══════════════════════════════════════════════════════════════════════════════
# INSTRUCTIONS:
# 1. Fill in all values marked with "your-...".
# 2. Vercel -> Project -> Settings -> Environment Variables
# 3. Paste ALL text into the FIRST "Key" box — Vercel parses the rest.
# 4. Apply to BOTH projects (client-page + admin-dashboard).

# ─── Firebase: Client SDK (Next.js / Realty App) ─────────────────────────────
# Canonical project: sierra-blu (matches .firebaserc)
NEXT_PUBLIC_FIREBASE_PROJECT_ID=sierra-blu
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyBZLN2jTTKV34SneGPoWRz1zoRpX5uODjs
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=sierra-blu.firebaseapp.com
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://sierra-blu.firebaseio.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=sierra-blu.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=941030513456
NEXT_PUBLIC_FIREBASE_APP_ID=1:941030513456:web:56209a1495d69f217086f5
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-ZP054BPJ8Q

# ─── Firebase: Client SDK (Vite / Admin Portal) ───────────────────────────────
VITE_FIREBASE_PROJECT_ID=sierra-blu
VITE_FIREBASE_API_KEY=AIzaSyBZLN2jTTKV34SneGPoWRz1zoRpX5uODjs
VITE_FIREBASE_AUTH_DOMAIN=sierra-blu.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=sierra-blu.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=941030513456
VITE_FIREBASE_APP_ID=1:941030513456:web:56209a1495d69f217086f5
VITE_FIREBASE_MEASUREMENT_ID=G-ZP054BPJ8Q

# ─── Firebase: Admin SDK ──────────────────────────────────────────────────────
# Method 1 (Recommended): Full service account JSON
# Get it: Firebase Console -> Project Settings -> Service Accounts -> Generate key
FIREBASE_SERVICE_ACCOUNT_JSON=your-service-account-json-content

# Method 2 (alternative): Individual fields
# FIREBASE_CLIENT_EMAIL=your-client-email
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour-Key-Here\n-----END PRIVATE KEY-----\n"

# ─── Cron Authentication ──────────────────────────────────────────────────────
# !! CRITICAL !! All 6 cron jobs return HTTP 503 until this is set.
# Vercel Cron sends this automatically as "Authorization: Bearer $CRON_SECRET".
# Generate: openssl rand -hex 32
CRON_SECRET=your-cron-secret-32-chars-min

# ─── Admin API Key ────────────────────────────────────────────────────────────
# Required by /api/houyez/seed in production — seed endpoint is disabled without it.
ADMIN_API_KEY=your-admin-api-key

# ─── Property Finder (PF Enterprise API) ─────────────────────────────────────
# Activates: /api/cron/sync-leads, /api/cron/sync-listings, /api/feeds/property-finder
# Get it: Property Finder Enterprise portal -> API Settings
PROPERTY_FINDER_API_KEY=your-property-finder-api-key

# ─── Google Gemini AI ─────────────────────────────────────────────────────────
# Activates: WhatsApp NLP parser, AI listing classifier, semantic search, matching engine
# Get it: https://aistudio.google.com/app/apikey
GOOGLE_AI_API_KEY=your-google-ai-api-key

# ─── Google Sheets (Broker Inbox Buffer) ─────────────────────────────────────
# Activates: /api/cron/ingest-from-sheets — polls raw_messages tab every 5 min
# GOOGLE_SERVICE_ACCOUNT_KEY: Full service account JSON as a single-line string
# Get it: GCP Console -> IAM -> Service Accounts -> Create Key (JSON)
GOOGLE_SERVICE_ACCOUNT_KEY=your-google-service-account-json
# BROKER_INBOX_SHEET_ID: The spreadsheet ID from the Google Sheets URL
BROKER_INBOX_SHEET_ID=your-google-sheets-spreadsheet-id

# ─── Airtable (Inventory Sync) ────────────────────────────────────────────────
# Activates: /api/sync/airtable, AirtableIntegrationService batch upserts
# AIRTABLE_API_KEY: Personal Access Token (not the legacy API key)
# Get it: Airtable -> Account -> Developer Hub -> Personal access tokens
AIRTABLE_API_KEY=your-airtable-personal-access-token
# AIRTABLE_BASE_ID: From the base URL — airtable.com/[BASE_ID]/...
AIRTABLE_BASE_ID=your-airtable-base-id
# AIRTABLE_TABLE_NAME: Comma-separated table name(s) to sync
AIRTABLE_TABLE_NAME=Listings

# ─── Twilio (WhatsApp Dispatch & Webhooks) ────────────────────────────────────
# Activates: /api/cron/whatsapp-dispatch, /api/webhooks/twilio-*, /api/whatsapp/*
# Get it: Twilio Console -> Account Info
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
# Optional: enables Twilio Messaging Service routing across sender numbers
TWILIO_MESSAGING_SERVICE_SID=your-twilio-messaging-service-sid

# ─── Application URLs ─────────────────────────────────────────────────────────
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_SITE_URL=https://sierra-estates.net
NEXT_PUBLIC_APP_URL=https://sierra-estates.net
NEXT_PUBLIC_CLIENT_URL=https://sierra-estates.net

# CORS: comma-separated origins for /api. Credentialed requests need explicit origins.
ALLOWED_ORIGINS=https://admin.sierra-estates.net,https://sierra-estates.net,http://localhost:3000,http://localhost:5173

# Intelligence OS console (Remix on Cloud Run) — embedded in /admin/intelligence-os
NEXT_PUBLIC_INTELLIGENCE_OS_URL=https://remix-remix-remix-sierra-estates-intelligence-os-755638710103.europe-west2.run.app

# ─── WhatsApp Lead Notifications ─────────────────────────────────────────────
# E.164 format (e.g. +201061399688). Queued via whatsapp-dispatch cron.
# Leave blank to disable.
LEAD_NOTIFY_WHATSAPP_NUMBER=

# ─── Other Integration Keys ───────────────────────────────────────────────────
SBR_SECRET_KEY=your-sbr-secret-key
SENDGRID_API_KEY=your-sendgrid-api-key
SENDER_EMAIL=noreply@sierraestatesrealty.com
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your-recaptcha-site-key
NEXT_PUBLIC_TELEGRAM_BOT_TOKEN=your-telegram-bot-token
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=your-telegram-bot-username
TELEGRAM_WEBHOOK_SECRET=

# ─── Local Dev Notes ─────────────────────────────────────────────────────────
# 1. Copy this file to apps/sierra-estates-realty/.env.local
# 2. Replace all "your-*" values with real credentials
# 3. JSON values (FIREBASE_SERVICE_ACCOUNT_JSON, GOOGLE_SERVICE_ACCOUNT_KEY)
#    must be a single line with no literal newlines — JSON.stringify() the object
# 4. Restart the dev server after saving
