{
  "compilerOptions": {
    "forceConsistentCasingInFileNames": true,
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "types": ["node"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@agents-core/*": ["../../packages/agents-core/src/*"],
      "@obsidian/*": ["../../packages/obsidian/src/*"],
      "@sierra-estates/obsidian": ["../../packages/obsidian/src/index.ts"],
      "@sierra-estates/obsidian/*": ["../../packages/obsidian/src/*"],
      "@sierra-estates/memory-engine": ["../../packages/memory-engine/src/index.ts"],
      "@sierra-estates/ui": ["../../packages/ui/src/index.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "__tests__",
    "**/*.test.ts",
    "**/*.test.tsx"
  ]
}
