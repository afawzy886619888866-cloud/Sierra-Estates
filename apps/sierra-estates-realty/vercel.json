{
  "name": "sierra-estates-client-page",
  "github": {
    "silent": true
  },
  "crons": [
    {
      "path": "/api/cron/sync-leads",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/ingest-from-sheets",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/sync-listings",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/maintenance",
      "schedule": "0 23 * * *"
    },
    {
      "path": "/api/cron/sync-master-sheet",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/cron/whatsapp-dispatch",
      "schedule": "*/10 * * * *"
    }
  ],
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ../../packages ../../pnpm-lock.yaml ../../pnpm-workspace.yaml ../../turbo.json || exit 1"
}

