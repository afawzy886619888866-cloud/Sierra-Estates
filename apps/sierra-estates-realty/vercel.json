{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "pnpm install --frozen-lockfile",
  "git": {
    "deploymentEnabled": false
  },
  "crons": [
    {
      "path": "/api/cron/sync-leads",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/sync-listings",
      "schedule": "0 6 * * *"
    }
  ],
  "regions": ["fra1"]
}
