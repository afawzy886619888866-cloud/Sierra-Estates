{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "pnpm install --frozen-lockfile",
  "crons": [
    {
      "path": "/api/cron/dispatch/night",
      "schedule": "45 2 * * *"
    },
    {
      "path": "/api/cron/dispatch/morning",
      "schedule": "45 6 * * *"
    },
    {
      "path": "/api/cron/redeploy-static-portal",
      "schedule": "0 0 * * 0"
    },
    {
      "path": "/api/cron/uptime-check",
      "schedule": "*/5 * * * *"
    }
  ],
  "regions": ["fra1"]
}
