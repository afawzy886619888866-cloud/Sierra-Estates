{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "paths": {
      "@sierra-estates/db": [
        "../../packages/db/lib/index.ts"
      ]
    },
    "moduleResolution": "bundler"
  },
  "include": [
    "src/**/*"
  ]
}
