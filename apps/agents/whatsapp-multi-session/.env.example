# ── Sierra Estates 8-Line Worker — environment ──────────────────────────────
# Copy to `.env` next to worker.js (git-ignored). Every value is optional;
# defaults live in worker.js / app-bridge.js.

# Gateway / API auth
WHATSAPP_GATEWAY_PORT=2785
# OPENWA_ADMIN_API_KEY=change-me        # x-api-key for the REST API
# OPENWA_OPERATOR_KEY=change-me         # secondary accepted key (defaults to admin)
# OPENWA_SESSION_IDS=line-1,line-2,line-3,line-4
# STRICT_GATEWAY_AUTH=1                 # require the API key even from localhost

# ── App Bridge (inbound webhook forwarding + heartbeat) ─────────────────────
# Target webhook. DEFAULT = the ADMIN production domain — SBR_SECRET_KEY is
# project-scoped and inbound has always used the ADMIN value (sierra-sec…).
# SE_APP_WEBHOOK_URL=https://admin.sierra-estates.net/api/webhooks/whatsapp

# Shared secret for the x-sbr-secret-key header.
# SBR_SECRET_KEY=

# Heartbeat target (public endpoint, no secret needed).
# SE_HEARTBEAT_URL=https://sierra-estates.net/api/whatsapp/heartbeat

# Set to 1 to disable forwarding + heartbeat entirely.
# SE_BRIDGE_DISABLE=0

# ── Local Workflow Runner Bridge (Closed-Loop Owner Outreach & Inbox) ───────
# Forwards every inbound message on line-1..line-8 to workflows/runner.js (:2786)
# SE_RUNNER_INBOUND_URL=http://127.0.0.1:2786/api/inbound
# RUNNER_API_KEY=change-me
# SE_RUNNER_BRIDGE_DISABLE=0

# ── Outbound (workflows on this machine talking to the worker) ──────────────
# WHATSAPP_API_URL=http://127.0.0.1:2785
# WHATSAPP_API_KEY=change-me
