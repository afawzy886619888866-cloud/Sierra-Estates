# VITE_BACKEND_API_URL: Base URL for the local API server used by the frontend.
# The bundled dev server listens on port 3001 by default.
VITE_BACKEND_API_URL="http://localhost:3001"

# Property Finder API credentials used by api/index.ts.
# These are server-side only and should NEVER be exposed to the frontend.
PF_API_KEY="YOUR_PROPERTY_FINDER_API_KEY"
PF_API_SECRET="YOUR_PROPERTY_FINDER_API_SECRET"

# Admin emails for authorization (comma-separated)
# ADMIN_EMAILS="admin1@example.com,admin2@example.com"

# SECURITY NOTE: WhatsApp, Telegram, and other external service credentials
# MUST be configured on the backend server only and accessed via secure API endpoints.
# Frontend code must never import or reference these credentials directly.
