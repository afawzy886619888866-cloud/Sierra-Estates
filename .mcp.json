      "serverUrl": "https://mcp.supabase.com/mcp?project_ref=gaxfqcietzoonlmatiot&features=docs%2Caccount%2Cdatabase%2Cdebugging%2Cdevelopment%2Cfunctions%2Cbranching"
    },
    "ruflo": {
      "command": "cmd.exe",
      "args": [
