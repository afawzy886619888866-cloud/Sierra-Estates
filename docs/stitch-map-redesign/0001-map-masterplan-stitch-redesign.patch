+/* ============================================================================
+   Sierra Estates · Interactive Spatial Masterplan (Stitch redesign v2)
+   ----------------------------------------------------------------------------
+   Scoped design system for the /properties map experience.
+   Two themes via [data-map-theme] on the map root:
+     light = "Alexandria — High-End Editorial" (Stitch, project 2455613122012383700)
+     dark  = "Nocturnal Masterplan" (same project, dark EN / dark AR renders)
+   Design laws (Alexandria): no 1px borders for hierarchy (surface tiers
+   instead; dark theme uses 1px hud hairlines as specified), soft diffuse
+   shadows ONLY on floating map elements, glassmorphism 85% + 20px blur,
+   one primary action per view, Noto Serif headline / Inter body /
+   Public Sans labels / Cairo Arabic.
+   ========================================================================== */
+
+/* ── Theme tokens ──────────────────────────────────────────────────────── */
+[data-map-theme='light'] {
+  --mp-glass: rgba(255, 255, 255, 0.85);
+  --mp-glass-strong: rgba(255, 255, 255, 0.92);
+  --mp-glass-blur: 20px;
+  --mp-shadow: 0 8px 28px rgba(0, 0, 0, 0.08);
+  --mp-shadow-lift: 0 12px 34px rgba(0, 0, 0, 0.14);
+  --mp-text: #1b1c1d;            /* M3 on-surface */
+  --mp-text-variant: #434653;    /* M3 on-surface-variant */
+  --mp-text-secondary: #6f7280;
+  --mp-outline-variant: #c3c6d5;
+  --mp-primary: #094cb2;         /* Alexandria primary */
+  --mp-sapphire: #1d4ed8;        /* top-tier compound accent */
+  --mp-sapphire-deep: #1e3a8a;
+  --mp-teal: #0d9488;            /* secondary compound accent */
+  --mp-teal-deep: #0f766e;
+  --mp-gold: #c9a24d;            /* brushed camel gold focus */
+  --mp-gold-deep: #b89b68;
+  --mp-pill-text: #0f172a;       /* deep midnight navy on map */
+  --mp-chip-bg: rgba(9, 76, 178, 0.1);
+  --mp-chip-text: #1e3a8a;
+  --mp-eyebrow: #6d5e00;         /* tertiary container ink */
+  --mp-badge-available: #0f766e;
+  --mp-badge-reserved: #b45309;
+  --mp-wash: linear-gradient(
+    160deg,
+    rgba(250, 249, 246, 0.28) 0%,
+    rgba(246, 244, 239, 0.1) 45%,
+    rgba(250, 249, 246, 0.3) 100%
+  );
+}
+
+[data-map-theme='dark'] {
+  --mp-glass: rgba(16, 24, 40, 0.85);
+  --mp-glass-strong: rgba(16, 24, 40, 0.92);
+  --mp-glass-blur: 20px;
+  --mp-shadow: 0 10px 30px rgba(2, 6, 23, 0.55);
+  --mp-shadow-lift: 0 16px 44px rgba(2, 6, 23, 0.7);
+  --mp-text: #ffffff;
+  --mp-text-variant: #c7d2e0;
+  --mp-text-secondary: #8a9bae;  /* nocturnal text-secondary */
+  --mp-outline-variant: #2a3b4c; /* hud hairline */
+  --mp-primary: #e7ebff;
+  --mp-sapphire: #06b6d4;        /* parcel-active neon cyan */
+  --mp-sapphire-deep: #22d3ee;
+  --mp-teal: #10b981;            /* parcel-alt electric emerald */
+  --mp-teal-deep: #34d399;
+  --mp-gold: #ffd700;            /* focal gold */
+  --mp-gold-deep: #f59e0b;
+  --mp-pill-text: #ffffff;
+  --mp-chip-bg: rgba(255, 255, 255, 0.14);
+  --mp-chip-text: #ffffff;
+  --mp-eyebrow: #f9e37a;
+  --mp-badge-available: #00c853;
+  --mp-badge-reserved: #ffab00;
+  --mp-wash: linear-gradient(
+    165deg,
+    rgba(6, 11, 18, 0.42) 0%,
+    rgba(6, 11, 18, 0.14) 45%,
+    rgba(2, 6, 23, 0.5) 100%
+  );
+}
+
+/* ── Shared glass primitives (map page only) ───────────────────────────── */
+.mp-glass {
+  background: var(--mp-glass);
+  -webkit-backdrop-filter: blur(var(--mp-glass-blur));
+  backdrop-filter: blur(var(--mp-glass-blur));
+  box-shadow: var(--mp-shadow);
+  border-radius: 14px;
+  color: var(--mp-text);
+}
+
+[data-map-theme='light'] .mp-glass {
+  border: none;
+}
+[data-map-theme='dark'] .mp-glass,
+.mp-glass.mp-glass-dark {
+  border: 1px solid var(--mp-outline-variant);
+}
+
+/* Map canvas warm/void wash (sits over tiles, never intercepts pointer) */
+.mp-map-wash {
+  position: absolute;
+  inset: 0;
+  background: var(--mp-wash);
+  pointer-events: none;
+  z-index: 380; /* above tile pane (200) / overlay panes (400+) start below 400 */
+  animation: se-map-fade 0.5s ease both;
+}
+
+/* ── Compound label pills (masterplan markers) ─────────────────────────── */
+.se-mp-wrap {
+  position: relative;
+}
+
+.se-mp-pill {
+  position: absolute;
+  left: 0;
+  top: 0;
+  display: inline-flex;
+  align-items: center;
+  gap: 7px;
+  padding: 5px 12px;
+  border-radius: 9999px;
+  white-space: nowrap;
+  cursor: pointer;
+  font-family: var(--font-label, 'Public Sans'), var(--font-jakarta, 'Plus Jakarta Sans'),
+    system-ui, sans-serif;
+  font-weight: 600;
+  letter-spacing: 0.02em;
+  color: var(--mp-pill-text);
+  background: var(--mp-glass);
+  -webkit-backdrop-filter: blur(12px);
+  backdrop-filter: blur(12px);
+  box-shadow: var(--mp-shadow);
+  transform: translate(-50%, -50%) scale(1);
+  transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.28s ease,
+    background 0.2s ease;
+  animation: se-mp-pill-in 0.55s cubic-bezier(0.16, 1, 0.3, 1) backwards;
+}
+
+[data-map-theme='dark'] .se-mp-pill {
+  border: 1px solid var(--mp-outline-variant);
+}
+
+/* Tier accents: sapphire for top-tier compounds, teal for the rest */
+.se-mp-pill.se-mp-tier-top {
+  background: linear-gradient(
+    135deg,
+    rgba(29, 78, 216, 0.16),
+    rgba(30, 58, 138, 0.12)
+  ),
+  var(--mp-glass);
+}
+[data-map-theme='dark'] .se-mp-pill.se-mp-tier-top {
+  background: linear-gradient(135deg, rgba(6, 182, 212, 0.18), rgba(6, 182, 212, 0.06)),
+    var(--mp-glass);
+}
+.se-mp-pill.se-mp-tier-alt {
+  background: linear-gradient(135deg, rgba(13, 148, 136, 0.15), rgba(15, 118, 110, 0.1)),
+    var(--mp-glass);
+}
+[data-map-theme='dark'] .se-mp-pill.se-mp-tier-alt {
+  background: linear-gradient(135deg, rgba(16, 185, 129, 0.16), rgba(16, 185, 129, 0.05)),
+    var(--mp-glass);
+}
+
+.se-mp-label {
+  letter-spacing: 0.01em;
+  text-shadow: 0 1px 2px rgba(15, 23, 42, 0.18);
+}
+[data-map-theme='dark'] .se-mp-label {
+  text-shadow: 0 1px 3px rgba(2, 6, 23, 0.8);
+}
+
+.se-mp-count {
+  font-family: var(--font-mono, 'JetBrains Mono'), ui-monospace, monospace;
+  font-size: 10px;
+  font-weight: 700;
+  padding: 1.5px 7px;
+  border-radius: 9999px;
+  background: var(--mp-chip-bg);
+  color: var(--mp-chip-text);
+  font-variant-numeric: tabular-nums;
+}
+
+/* Hover: pill lift 1.15× (restyle of the classic hover contract) */
+.se-mp-wrap:hover .se-mp-pill {
+  transform: translate(-50%, -50%) scale(1.15);
+  box-shadow: var(--mp-shadow-lift);
+  z-index: 950;
+}
+
+/* Dark hover: neon outline (parcel-active cyan / parcel-alt emerald) */
+[data-map-theme='dark'] .se-mp-wrap:hover .se-mp-pill.se-mp-tier-top {
+  border: 1.5px solid var(--mp-sapphire);
+  box-shadow: 0 0 22px rgba(6, 182, 212, 0.3), var(--mp-shadow-lift);
+}
+[data-map-theme='dark'] .se-mp-wrap:hover .se-mp-pill.se-mp-tier-alt {
+  border: 1.5px solid var(--mp-teal);
+  box-shadow: 0 0 22px rgba(16, 185, 129, 0.28), var(--mp-shadow-lift);
+}
+
+/* Proximity focus (z ≥ 14 nearest compound, or selected):
+   golden ring + radial aura — the SODIC VILLETTE treatment from the renders */
+.se-mp-pill.se-mp-focus {
+  font-weight: 800;
+  padding: 7px 15px;
+  border-radius: 9999px;
+  transform: translate(-50%, -50%) scale(1.08);
+  background: var(--mp-glass-strong);
+  box-shadow: 0 0 0 1.5px var(--mp-gold), 0 0 26px rgba(201, 162, 77, 0.45),
+    0 10px 30px rgba(0, 0, 0, 0.18);
+}
+[data-map-theme='dark'] .se-mp-pill.se-mp-focus {
+  border: 1.5px solid var(--mp-gold);
+  box-shadow: 0 0 30px rgba(255, 215, 0, 0.42), 0 0 0 1.5px rgba(255, 215, 0, 0.55),
+    var(--mp-shadow-lift);
+}
+.se-mp-pill.se-mp-focus::after {
+  content: '';
+  position: absolute;
+  inset: -14px;
+  border-radius: 9999px;
+  background: radial-gradient(
+    circle,
+    rgba(201, 162, 77, 0.22) 0%,
+    rgba(201, 162, 77, 0) 68%
+  );
+  pointer-events: none;
+  z-index: -1;
+}
+[data-map-theme='dark'] .se-mp-pill.se-mp-focus::after {
+  background: radial-gradient(circle, rgba(255, 215, 0, 0.2) 0%, rgba(255, 215, 0, 0) 70%);
+}
+
+[data-map-theme='light'] .se-mp-pill.se-mp-focus {
+  color: #0f172a;
+}
+
+/* Staggered ping halo (liveliness, from code.html behavior reference) */
+.se-mp-ping {
+  position: absolute;
+  left: 50%;
+  top: 50%;
+  width: 46px;
+  height: 46px;
+  margin: -23px 0 0 -23px;
+  border-radius: 50%;
+  pointer-events: none;
+  border: 1.5px solid var(--mp-gold);
+  opacity: 0;
+  animation: se-mp-ping 2.6s cubic-bezier(0, 0, 0.2, 1) infinite;
+}
+@keyframes se-mp-ping {
+  0% { transform: scale(0.5); opacity: 0.55; }
+  75%, 100% { transform: scale(1.6); opacity: 0; }
+}
+
+/* ── Unit pins (street zoom) — masterplan restyle ───────────────────────── */
+.se-mp-unit {
+  position: absolute;
+  left: 0;
+  top: 0;
+  display: inline-flex;
+  align-items: center;
+  gap: 5px;
+  padding: 3.5px 9px;
+  border-radius: 11px;
+  font-family: var(--font-mono, 'JetBrains Mono'), ui-monospace, monospace;
+  font-size: 10.5px;
+  font-weight: 700;
+  white-space: nowrap;
+  cursor: pointer;
+  transform: translate(-50%, -50%) scale(1);
+  transition: transform 0.18s ease, box-shadow 0.18s ease;
+  animation: se-mp-unit-in 0.4s cubic-bezier(0.16, 1, 0.3, 1) backwards;
+}
+.se-mp-unit .se-mp-unit-dot {
+  width: 6px;
+  height: 6px;
+  border-radius: 50%;
+  flex: none;
+}
+.se-mp-wrap:hover .se-mp-unit {
+  transform: translate(-50%, -50%) scale(1.12);
+  z-index: 960;
+}
+.se-mp-unit.se-mp-unit-active {
+  z-index: 9999;
+  box-shadow: 0 0 0 1.5px var(--mp-gold), 0 0 24px rgba(201, 162, 77, 0.5);
+}
+
+/* Full-bleed masterplan map container (inside the page .wrap) —
+   immersive: no outer card chrome, taller canvas per the v2 order. */
+.mp-full-map {
+  border: none;
+  min-height: 620px;
+}
+
+@media (max-width: 900px) {
+  .mp-full-map {
+    min-height: 420px;
+  }
+}
+
+/* ── Header pill (top-center) ──────────────────────────────────────────── */
+.mp-header-pill {
+  position: absolute;
+  top: 18px;
+  left: 50%;
+  transform: translateX(-50%);
+  z-index: 1060;
+  display: inline-flex;
+  align-items: center;
+  gap: 10px;
+  padding: 9px 22px;
+  border-radius: 9999px;
+  max-width: min(92vw, 760px);
+}
+
+.mp-header-pill .mp-header-text {
+  font-family: var(--font-label, 'Public Sans'), 'Cairo', system-ui, sans-serif;
+  font-size: 12px;
+  font-weight: 700;
+  letter-spacing: 0.1em;
+  text-transform: uppercase;
+  color: var(--mp-text);
+  white-space: nowrap;
+  overflow: hidden;
+  text-overflow: ellipsis;
+}
+.mp-header-pill .mp-header-text .mp-ar {
+  font-family: 'Cairo', var(--font-label, 'Public Sans'), sans-serif;
+  letter-spacing: 0.02em;
+}
+
+/* ── Top-right control cluster (theme × language toggles) ──────────────── */
+.mp-toggle-cluster {
+  position: absolute;
+  top: 18px;
+  right: 18px;
+  z-index: 1060;
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  flex-wrap: wrap;
+  justify-content: flex-end;
+}
+
+.mp-toggle-group {
+  display: inline-flex;
+  align-items: center;
+  gap: 2px;
+  padding: 3px;
+  border-radius: 9999px;
+}
+
+.mp-toggle {
+  appearance: none;
+  border: none;
+  background: transparent;
+  color: var(--mp-text-secondary);
+  font-family: var(--font-label, 'Public Sans'), 'Cairo', system-ui, sans-serif;
+  font-size: 11px;
+  font-weight: 700;
+  letter-spacing: 0.04em;
+  padding: 5px 12px;
+  border-radius: 9999px;
+  cursor: pointer;
+  transition: background 0.18s ease, color 0.18s ease;
+  white-space: nowrap;
+}
+.mp-toggle:hover {
+  color: var(--mp-text);
+  background: rgba(127, 137, 148, 0.14);
+}
+.mp-toggle[data-active='true'] {
+  background: var(--mp-sapphire);
+  color: #ffffff;
+}
+[data-map-theme='dark'] .mp-toggle[data-active='true'] {
+  background: var(--mp-gold);
+  color: #060b12;
+}
+.mp-toggle.mp-toggle-lang[data-active='true'] {
+  background: var(--mp-teal);
+  color: #ffffff;
+}
+[data-map-theme='dark'] .mp-toggle.mp-toggle-lang[data-active='true'] {
+  background: var(--mp-teal-deep);
+  color: #06281f;
+}
+.mp-toggle .mp-ar-glyph {
+  font-family: 'Cairo', sans-serif;
+  font-size: 12.5px;
+}
+
+/* ── Top-left filter cluster (glass overlay) ───────────────────────────── */
+.mp-filter-cluster {
+  position: absolute;
+  top: 18px;
+  left: 18px;
+  z-index: 1050;
+  display: flex;
+  flex-direction: column;
+  gap: 8px;
+  width: min(430px, calc(100vw - 36px));
+  animation: se-map-fade 0.4s ease both;
+}
+
+.mp-filter-row {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  flex-wrap: wrap;
+}
+
+.mp-search {
+  display: inline-flex;
+  align-items: center;
+  gap: 8px;
+  padding: 7px 12px;
+  border-radius: 9999px;
+  flex: 1 1 190px;
+  min-width: 170px;
+}
+.mp-search input {
+  appearance: none;
+  border: none;
+  background: transparent;
+  outline: none;
+  color: var(--mp-text);
+  font-family: var(--font-jakarta, 'Plus Jakarta Sans'), 'Cairo', system-ui, sans-serif;
+  font-size: 12.5px;
+  width: 100%;
+  min-width: 0;
+}
+.mp-search input::placeholder {
+  color: var(--mp-text-secondary);
+}
+.mp-search .mp-search-icon {
+  color: var(--mp-text-secondary);
+  flex: none;
+}
+
+.mp-filter-pill {
+  appearance: none;
+  border: none;
+  background: rgba(127, 137, 148, 0.12);
+  color: var(--mp-text-variant);
+  font-family: var(--font-label, 'Public Sans'), 'Cairo', system-ui, sans-serif;
+  font-size: 11.5px;
+  font-weight: 700;
+  padding: 6px 14px;
+  border-radius: 9999px;
+  cursor: pointer;
+  transition: background 0.16s ease, color 0.16s ease;
+  white-space: nowrap;
+}
+.mp-filter-pill:hover {
+  background: rgba(127, 137, 148, 0.22);
+  color: var(--mp-text);
+}
+.mp-filter-pill[data-active='true'] {
+  background: var(--mp-sapphire);
+  color: #ffffff;
+}
+[data-map-theme='dark'] .mp-filter-pill[data-active='true'] {
+  background: var(--mp-gold);
+  color: #060b12;
+}
+.mp-filter-pill[data-active='true'][data-tone='rent'] {
+  background: var(--mp-teal);
+  color: #ffffff;
+}
+[data-map-theme='dark'] .mp-filter-pill[data-active='true'][data-tone='rent'] {
+  background: var(--mp-teal-deep);
+  color: #06281f;
+}
+
+.mp-select {
+  appearance: none;
+  border: none;
+  border-radius: 9999px;
+  background: rgba(127, 137, 148, 0.12);
+  color: var(--mp-text);
+  font-family: var(--font-jakarta, 'Plus Jakarta Sans'), 'Cairo', system-ui, sans-serif;
+  font-size: 11.5px;
+  font-weight: 600;
+  padding: 6px 26px 6px 14px;
+  cursor: pointer;
+  max-width: 100%;
+  background-image: url("data:image/svg+xml;charset=UTF-8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='10' height='6' viewBox='0 0 10 6'%3E%3Cpath d='M1 1l4 4 4-4' fill='none' stroke='%23737784' stroke-width='1.6' stroke-linecap='round'/%3E%3C/svg%3E");
+  background-repeat: no-repeat;
+  background-position: right 10px center;
+}
+.mp-select option {
+  color: #1b1c1d;
+  background: #ffffff;
+}
+
+.mp-filters-panel {
+  padding: 12px;
+  border-radius: 14px;
+  display: flex;
+  flex-direction: column;
+  gap: 10px;
+}
+.mp-filters-panel .mp-panel-label {
+  font-family: var(--font-label, 'Public Sans'), 'Cairo', sans-serif;
+  font-size: 9px;
+  font-weight: 700;
+  letter-spacing: 0.16em;
+  text-transform: uppercase;
+  color: var(--mp-text-secondary);
+}
+.mp-filters-grid {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 8px;
+  align-items: center;
+}
+
+/* ── Registry Benchmark HUD (right, vertically centered) ───────────────── */
+.mp-benchmark-hud {
+  position: absolute;
+  top: 50%;
+  right: 18px;
+  transform: translateY(-50%);
+  z-index: 1040;
+  width: 218px;
+  padding: 14px 16px;
+  display: flex;
+  flex-direction: column;
+  gap: 10px;
+  animation: se-map-fade 0.4s ease both;
+}
+.mp-benchmark-hud .mp-hud-eyebrow {
+  font-family: var(--font-label, 'Public Sans'), 'Cairo', sans-serif;
+  font-size: 8.5px;
+  font-weight: 700;
+  letter-spacing: 0.16em;
+  text-transform: uppercase;
+  color: var(--mp-text-secondary);
+  line-height: 1.5;
+}
+.mp-hud-row {
+  display: flex;
+  flex-direction: column;
+  gap: 2px;
+}
+.mp-hud-row .mp-hud-value {
+  font-family: var(--font-mono, 'JetBrains Mono'), ui-monospace, monospace;
+  font-size: 17px;
+  font-weight: 700;
+  color: var(--mp-text);
+  font-variant-numeric: tabular-nums;
+  line-height: 1.2;
+}
+.mp-hud-row .mp-hud-label {
+  font-family: var(--font-jakarta, 'Plus Jakarta Sans'), 'Cairo', sans-serif;
+  font-size: 10.5px;
+  color: var(--mp-text-secondary);
+}
+
+/* ── Bottom-left: compass + coordinates + projection label ─────────────── */
+.mp-southwest-chrome {
+  position: absolute;
+  left: 16px;
+  bottom: 16px;
+  z-index: 1040;
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+  pointer-events: none;
+  animation: se-map-fade 0.4s ease both;
+}
+.mp-compass {
+  width: 52px;
+  height: 52px;
+  filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.18));
+}
+.mp-coords {
+  font-family: var(--font-mono, 'JetBrains Mono'), ui-monospace, monospace;
+  font-size: 10px;
+  color: var(--mp-text-secondary);
+  letter-spacing: 0.04em;
+  font-variant-numeric: tabular-nums;
+}
+.mp-proj-label {
+  font-family: var(--font-mono, 'JetBrains Mono'), ui-monospace, monospace;
+  font-size: 8.5px;
+  color: var(--mp-text-secondary);
+  opacity: 0.75;
+  letter-spacing: 0.08em;
+}
+.mp-scalebar {
+  display: flex;
+  align-items: center;
+  gap: 6px;
+  pointer-events: none;
+}
+.mp-scalebar .mp-scalebar-line {
+  height: 2px;
+  background: var(--mp-text-secondary);
+  border-radius: 2px;
+  position: relative;
+}
+.mp-scalebar .mp-scalebar-line::before,
+.mp-scalebar .mp-scalebar-line::after {
+  content: '';
+  position: absolute;
+  top: -3px;
+  width: 2px;
+  height: 8px;
+  background: var(--mp-text-secondary);
+}
+.mp-scalebar .mp-scalebar-line::before { left: 0; }
+.mp-scalebar .mp-scalebar-line::after { right: 0; }
+.mp-scalebar .mp-scalebar-text {
+  font-family: var(--font-mono, 'JetBrains Mono'), monospace;
+  font-size: 9px;
+  color: var(--mp-text-secondary);
+}
+
+/* ── Bottom-right: zoom stack + logo ───────────────────────────────────── */
+.mp-northeast-chrome {
+  position: absolute;
+  right: 16px;
+  bottom: 40px; /* clears the required tile-attribution strip */
+  z-index: 1040;
+  display: flex;
+  align-items: flex-end;
+  gap: 10px;
+  animation: se-map-fade 0.4s ease both;
+}
+.mp-zoom-stack {
+  display: flex;
+  flex-direction: column;
+  gap: 4px;
+}
+.mp-zoom-btn {
+  appearance: none;
+  border: none;
+  width: 36px;
+  height: 36px;
+  border-radius: 9999px;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  cursor: pointer;
+  color: var(--mp-text);
+  background: var(--mp-glass);
+  -webkit-backdrop-filter: blur(var(--mp-glass-blur));
+  backdrop-filter: blur(var(--mp-glass-blur));
+  box-shadow: var(--mp-shadow);
+  transition: transform 0.16s ease, box-shadow 0.16s ease;
+}
+[data-map-theme='dark'] .mp-zoom-btn {
+  border: 1px solid var(--mp-outline-variant);
+}
+.mp-zoom-btn:hover {
+  transform: scale(1.08);
+  box-shadow: var(--mp-shadow-lift);
+}
+.mp-logo-mark {
+  height: 34px;
+  width: auto;
+  border-radius: 6px;
+  box-shadow: var(--mp-shadow);
+}
+
+/* ── Inventory Registry Modal ──────────────────────────────────────────── */
+.mp-registry-backdrop {
+  position: absolute;
+  inset: 0;
+  z-index: 1080;
+  background: rgba(9, 18, 33, 0.12);
+}
+[data-map-theme='dark'] .mp-registry-backdrop {
+  background: rgba(2, 6, 23, 0.32);
+}
+
+.mp-registry-modal {
+  position: absolute;
+  top: 50%;
+  left: 65%;
+  transform: translateY(-50%);
+  z-index: 1090;
+  width: min(560px, 92vw);
+  max-height: 70vh;
+  display: flex;
+  flex-direction: column;
+  border-radius: 16px;
+  overflow: hidden;
+  animation: se-mp-modal-in 0.3s cubic-bezier(0.16, 1, 0.3, 1) both;
+}
+@keyframes se-mp-modal-in {
+  from { opacity: 0; transform: translateY(-50%) translateX(18px) scale(0.97); }
+  to { opacity: 1; transform: translateY(-50%) translateX(0) scale(1); }
+}
+
+.mp-registry-head {
+  padding: 16px 18px 12px;
+  display: flex;
+  flex-direction: column;
+  gap: 3px;
+  position: relative;
+}
+.mp-registry-eyebrow {
+  display: inline-flex;
+  align-items: center;
+  gap: 7px;
+  font-family: var(--font-label, 'Public Sans'), 'Cairo', sans-serif;
+  font-size: 9.5px;
+  font-weight: 700;
+  letter-spacing: 0.14em;
+  text-transform: uppercase;
+  color: var(--mp-text-secondary);
+}
+.mp-live-dot {
+  width: 7px;
+  height: 7px;
+  border-radius: 50%;
+  background: var(--mp-badge-available);
+  box-shadow: 0 0 0 0 rgba(0, 200, 83, 0.5);
+  animation: se-mp-pulse-dot 1.8s ease-out infinite;
+  flex: none;
+}
+@keyframes se-mp-pulse-dot {
+  0% { box-shadow: 0 0 0 0 rgba(0, 200, 83, 0.55); }
+  70% { box-shadow: 0 0 0 7px rgba(0, 200, 83, 0); }
+  100% { box-shadow: 0 0 0 0 rgba(0, 200, 83, 0); }
+}
+.mp-registry-title {
+  font-family: var(--font-headline, 'Noto Serif'), 'Cairo', Georgia, serif;
+  font-size: 19px;
+  font-weight: 700;
+  color: var(--mp-text);
+  line-height: 1.3;
+  padding-right: 34px;
+}
+.mp-registry-title .mp-ar-name {
+  font-family: 'Cairo', var(--font-headline, 'Noto Serif'), sans-serif;
+}
+.mp-registry-close {
+  position: absolute;
+  top: 12px;
+  right: 12px;
+  appearance: none;
+  border: none;
+  background: rgba(127, 137, 148, 0.14);
+  color: var(--mp-text);
+  width: 28px;
+  height: 28px;
+  border-radius: 9999px;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  cursor: pointer;
+  transition: background 0.15s ease;
+}
+.mp-registry-close:hover {
+  background: rgba(127, 137, 148, 0.3);
+}
+
+.mp-registry-scroll {
+  overflow-y: auto;
+  flex: 1;
+  min-height: 0;
+  overscroll-behavior: contain;
+}
+
+.mp-registry-table {
+  width: 100%;
+  border-collapse: collapse;
+  font-size: 11.5px;
+}
+.mp-registry-table thead th {
+  position: sticky;
+  top: 0;
+  z-index: 2;
+  background: var(--mp-glass-strong);
+  -webkit-backdrop-filter: blur(var(--mp-glass-blur));
+  backdrop-filter: blur(var(--mp-glass-blur));
+  font-family: var(--font-label, 'Public Sans'), 'Cairo', sans-serif;
+  font-size: 9px;
+  font-weight: 700;
+  letter-spacing: 0.13em;
+  text-transform: uppercase;
+  color: var(--mp-text-secondary);
+  text-align: left;
+  padding: 8px 10px;
+  white-space: nowrap;
+}
+.mp-registry-table tbody tr {
+  cursor: pointer;
+  transition: background 0.13s ease;
+}
+.mp-registry-table tbody tr:hover {
+  background: rgba(29, 78, 216, 0.07);
+}
+[data-map-theme='dark'] .mp-registry-table tbody tr:hover {
+  background: rgba(6, 182, 212, 0.08);
+}
+.mp-registry-table td {
+  padding: 8px 10px;
+  color: var(--mp-text);
+  border-top: 1px solid rgba(127, 137, 148, 0.14);
+  white-space: nowrap;
+  vertical-align: middle;
+}
+.mp-registry-table td.mp-cell-code {
+  font-family: var(--font-mono, 'JetBrains Mono'), ui-monospace, monospace;
+  font-weight: 700;
+  font-size: 11px;
+}
+.mp-registry-table td.mp-cell-num {
+  font-family: var(--font-mono, 'JetBrains Mono'), ui-monospace, monospace;
+  font-variant-numeric: tabular-nums;
+}
+.mp-registry-table td.mp-cell-price {
+  font-family: var(--font-mono, 'JetBrains Mono'), ui-monospace, monospace;
+  font-weight: 700;
+  font-size: 12px;
+  color: var(--mp-teal-deep);
+}
+[data-map-theme='dark'] .mp-registry-table td.mp-cell-price {
+  color: #34d399;
+}
+.mp-status-pill {
+  display: inline-block;
+  font-family: var(--font-label, 'Public Sans'), 'Cairo', sans-serif;
+  font-size: 9px;
+  font-weight: 700;
+  letter-spacing: 0.06em;
+  text-transform: uppercase;
+  padding: 2px 9px;
+  border-radius: 9999px;
+}
+.mp-status-pill[data-status='available'] {
+  background: var(--mp-badge-available);
+  color: #ffffff;
+}
+[data-map-theme='light'] .mp-status-pill[data-status='available'] {
+  color: #ffffff;
+}
+.mp-status-pill[data-status='reserved'] {
+  background: var(--mp-badge-reserved);
+  color: #060b12;
+}
+.mp-status-pill[data-status='other'] {
+  background: rgba(127, 137, 148, 0.18);
+  color: var(--mp-text-variant);
+}
+
+.mp-registry-empty {
+  padding: 26px 18px;
+  text-align: center;
+  font-family: var(--font-jakarta, 'Plus Jakarta Sans'), 'Cairo', sans-serif;
+  font-size: 12.5px;
+  color: var(--mp-text-secondary);
+  line-height: 1.6;
+}
+
+.mp-registry-foot {
+  padding: 12px 18px;
+  display: flex;
+  gap: 10px;
+  align-items: center;
+  background: var(--mp-glass-strong);
+  -webkit-backdrop-filter: blur(var(--mp-glass-blur));
+  backdrop-filter: blur(var(--mp-glass-blur));
+}
+[data-map-theme='dark'] .mp-registry-foot {
+  border-top: 1px solid var(--mp-outline-variant);
+}
+.mp-cta {
+  flex: 1;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  gap: 7px;
+  padding: 10px 14px;
+  border-radius: 10px;
+  font-family: var(--font-label, 'Public Sans'), 'Cairo', sans-serif;
+  font-size: 11px;
+  font-weight: 800;
+  letter-spacing: 0.08em;
+  text-transform: uppercase;
+  cursor: pointer;
+  text-decoration: none;
+  transition: transform 0.15s ease, filter 0.15s ease;
+  white-space: nowrap;
+}
+.mp-cta:hover {
+  transform: translateY(-1px);
+  filter: brightness(1.06);
+}
+.mp-cta-ghost {
+  border: 1.5px solid var(--mp-text-variant);
+  background: transparent;
+  color: var(--mp-text);
+}
+[data-map-theme='dark'] .mp-cta-ghost {
+  border-color: var(--mp-sapphire);
+  color: #ffffff;
+}
+.mp-cta-primary {
+  border: none;
+  background: #10b981;
+  color: #ffffff;
+}
+
+/* Keep the mandatory CARTO/OSM attribution legible but unobtrusive,
+   tinted per theme (it sits bottom-right under the zoom stack). */
+[data-map-theme] .leaflet-control-attribution {
+  background: var(--mp-glass);
+  color: var(--mp-text-secondary);
+  font-size: 9px;
+  padding: 2px 8px;
+  border-radius: 8px 0 0 0;
+  -webkit-backdrop-filter: blur(8px);
+  backdrop-filter: blur(8px);
+}
+[data-map-theme] .leaflet-control-attribution a {
+  color: var(--mp-text-secondary);
+}
+
+/* ── Marker tooltip card (masterplan) ──────────────────────────────────── */
+.se-mp-tooltip {
+  min-width: 180px;
+  font-family: var(--font-jakarta, 'Plus Jakarta Sans'), 'Cairo', sans-serif;
+  line-height: 1.45;
+}
+.se-mp-tooltip .se-mp-tip-eyebrow {
+  font-family: var(--font-label, 'Public Sans'), 'Cairo', sans-serif;
+  font-size: 8.5px;
+  font-weight: 700;
+  letter-spacing: 0.14em;
+  text-transform: uppercase;
+  color: #64748b;
+  margin-bottom: 3px;
+}
+.se-mp-tooltip .se-mp-tip-name {
+  font-family: var(--font-headline, 'Noto Serif'), 'Cairo', Georgia, serif;
+  font-size: 14.5px;
+  font-weight: 700;
+  color: #0f172a;
+}
+.se-mp-tooltip .se-mp-tip-sub {
+  font-size: 10.5px;
+  color: #64748b;
+  margin-top: 1px;
+}
+.se-mp-tooltip .se-mp-tip-badge {
+  display: inline-block;
+  margin-top: 6px;
+  font-size: 9.5px;
+  font-weight: 700;
+  padding: 2px 8px;
+  border-radius: 9999px;
+  background: rgba(16, 185, 129, 0.14);
+  color: #0f766e;
+}
+.se-mp-tooltip .se-mp-tip-price {
+  display: block;
+  margin-top: 5px;
+  font-family: var(--font-mono, 'JetBrains Mono'), monospace;
+  font-size: 11px;
+  font-weight: 700;
+  color: #0f766e;
+}
+.se-mp-tooltip .se-mp-tip-inspect {
+  display: inline-flex;
+  align-items: center;
+  gap: 4px;
+  margin-top: 8px;
+  border: none;
+  background: transparent;
+  padding: 0;
+  font-family: var(--font-label, 'Public Sans'), 'Cairo', sans-serif;
+  font-size: 10.5px;
+  font-weight: 800;
+  letter-spacing: 0.06em;
+  text-transform: uppercase;
+  color: #094cb2;
+  cursor: pointer;
+}
+.se-mp-tooltip .se-mp-tip-inspect:hover {
+  text-decoration: underline;
+}
+
+/* ── Entrance keyframes ────────────────────────────────────────────────── */
+@keyframes se-mp-pill-in {
+  from { opacity: 0; transform: translate(-50%, -80%) scale(0.82); }
+  to { opacity: 1; transform: translate(-50%, -50%) scale(1); }
+}
+@keyframes se-mp-unit-in {
+  from { opacity: 0; transform: translate(-50%, -40%) scale(0.6); }
+  to { opacity: 1; transform: translate(-50%, -50%) scale(1); }
+}
+
+/* ── Responsive (owner: "fit to page pc and mobile") ───────────────────── */
+@media (max-width: 900px) {
+  .mp-header-pill {
+    top: 12px;
+    padding: 7px 14px;
+    max-width: calc(100vw - 190px);
+  }
+  .mp-header-pill .mp-header-text {
+    font-size: 10px;
+    letter-spacing: 0.06em;
+  }
+  .mp-toggle-cluster {
+    top: 12px;
+    right: 12px;
+    gap: 6px;
+  }
+  .mp-toggle {
+    padding: 4px 9px;
+    font-size: 10px;
+  }
+  .mp-filter-cluster {
+    top: 64px;
+    left: 12px;
+    right: 12px;
+    width: auto;
+  }
+  .mp-filter-row {
+    flex-wrap: nowrap;
+    overflow-x: auto;
+    scrollbar-width: none;
+    -ms-overflow-style: none;
+    padding-bottom: 2px;
+  }
+  .mp-filter-row::-webkit-scrollbar {
+    display: none;
+  }
+  .mp-search {
+    flex: 1 0 150px;
+  }
+  .mp-benchmark-hud {
+    display: none; /* mobile: declutter — counts live in the filter cluster */
+  }
+  .mp-southwest-chrome .mp-proj-label,
+  .mp-southwest-chrome .mp-scalebar {
+    display: none;
+  }
+  .mp-compass {
+    width: 40px;
+    height: 40px;
+  }
+
+  /* Inventory modal → full-width bottom sheet */
+  .mp-registry-modal {
+    top: auto;
+    bottom: 0;
+    left: 0;
+    right: 0;
+    width: 100%;
+    max-height: 62vh;
+    border-radius: 18px 18px 0 0;
+    transform: none;
+    animation: se-mp-sheet-in 0.32s cubic-bezier(0.16, 1, 0.3, 1) both;
+  }
+  @keyframes se-mp-sheet-in {
+    from { opacity: 0; transform: translateY(36px); }
+    to { opacity: 1; transform: translateY(0); }
+  }
+  .mp-registry-foot {
+    padding-bottom: calc(12px + env(safe-area-inset-bottom, 0px));
+  }
+}
+
+@media (max-width: 560px) {
+  .mp-northeast-chrome .mp-logo-mark {
+    display: none;
+  }
+  .mp-header-pill {
+    display: none; /* smallest screens: the H1 + sub above carry the title */
+  }
+  .mp-toggle-cluster {
+    flex-direction: column;
+    align-items: flex-end;
+  }
+}
+
+/* ── Reduced motion ────────────────────────────────────────────────────── */
+@media (prefers-reduced-motion: reduce) {
+  .se-mp-pill,
+  .se-mp-unit,
+  .mp-registry-modal,
+  .mp-map-wash,
+  .mp-benchmark-hud,
+  .mp-filter-cluster,
+  .mp-southwest-chrome,
+  .mp-northeast-chrome {
+    animation: none;
+  }
+  .se-mp-ping,
+  .mp-live-dot {
+    animation: none;
+  }
+  .se-mp-pill,
+  .se-mp-unit,
+  .se-mp-wrap:hover .se-mp-pill,
+  .se-mp-wrap:hover .se-mp-unit {
+    transition: none;
+  }
+}
