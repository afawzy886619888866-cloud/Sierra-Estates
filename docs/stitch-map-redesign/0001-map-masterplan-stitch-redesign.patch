+'use client';
+
+/**
+ * Sierra Estates · Inventory Registry Modal (Stitch masterplan redesign)
+ * ----------------------------------------------------------------------------
+ * Floating glass registry opened by clicking a compound pill on the
+ * /properties masterplan map. Lists that compound's REAL live units in a
+ * spreadsheet layout (UNIT CODE | TYPE | BUA m² | PRICE | STATUS).
+ *
+ * §21 NO-FABRICATION (project law):
+ * - Every row is a real listing passed down from /api/inventory data.
+ * - The plot-area column is dropped entirely (no real plot/land-area field
+ *   exists in the listing payload).
+ * - The STATUS column is dropped entirely when no row carries a real
+ *   availability/status value.
+ * - Empty cells stay empty ("?"/blank) — never invented values.
+ * - Prices render exactly as the site's real `priceLabel` (EGP only; USD
+ *   subtext omitted — no live FX package is wired).
+ * - The 360° INSPECTION CTA links to a real property detail page — it never
+ *   opens an empty fake viewer.
+ */
+
+import React, { useEffect, useMemo, useRef } from 'react';
+import Link from 'next/link';
+import { X, RotateCw, MessageCircle } from 'lucide-react';
+import type { CompoundLocation } from './compounds-data';
+
+export type RegistryLang = 'en' | 'ar' | 'bi';
+
+export interface RegistryUnit {
+  id: string;
+  code: string;
+  compound: string;
+  type: string;
+  /** Built-up area in m². 0 = unknown → renders an empty cell (§21). */
+  area: number;
+  /** Real numeric price (EGP). 0/undefined = unpriced. Powers the live
+   *  "From {min} EGP" tooltip line and the benchmark price index. */
+  price?: number;
+  /** Real formatted price label from the live inventory (EGP). */
+  priceLabel: string;
+  mode: 'sale' | 'rent';
+  /** Real availability/status field from the listing ('' when unknown). */
+  status?: string;
+  img?: string;
+}
+
+export interface InventoryRegistryModalProps {
+  compound: CompoundLocation | null;
+  units: RegistryUnit[];
+  lang?: RegistryLang;
+  onClose: () => void;
+  onSelectUnit?: (unit: RegistryUnit) => void;
+}
+
+function statusTone(value: string): 'available' | 'reserved' | 'other' {
+  const v = value.toLowerCase();
+  if (v === 'available' || v === 'active' || v === 'for sale' || v === 'for rent') return 'available';
+  if (v === 'reserved' || v === 'held') return 'reserved';
+  return 'other';
+}
+
+export default function InventoryRegistryModal({
+  compound,
+  units,
+  lang = 'en',
+  onClose,
+  onSelectUnit,
+}: InventoryRegistryModalProps) {
+  const isAr = lang === 'ar';
+  const isBi = lang === 'bi';
+  const rtl = isAr; // Bilingual keeps LTR chrome with Arabic-first labels
+  const panelRef = useRef<HTMLDivElement>(null);
+
+  // ESC to close + focus trap (keyboard accessibility contract).
+  useEffect(() => {
+    if (!compound) return;
+    const panel = panelRef.current;
+    const focusables = panel?.querySelectorAll<HTMLElement>(
+      'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])'
+    );
+    (focusables?.[0] ?? panel)?.focus?.();
+
+    const onKey = (e: KeyboardEvent) => {
+      if (e.key === 'Escape') {
+        e.preventDefault();
+        onClose();
+        return;
+      }
+      if (e.key !== 'Tab' || !focusables || focusables.length === 0) return;
+      const first = focusables[0];
+      const last = focusables[focusables.length - 1];
+      if (e.shiftKey && document.activeElement === first) {
+        e.preventDefault();
+        last.focus();
+      } else if (!e.shiftKey && document.activeElement === last) {
+        e.preventDefault();
+        first.focus();
+      }
+    };
+    window.addEventListener('keydown', onKey);
+    return () => window.removeEventListener('keydown', onKey);
+  }, [compound, onClose]);
+
+  // Real column contract: STATUS column only when at least one row carries
+  // a real availability value (§21 — never render a fabricated status).
+  const showStatusColumn = useMemo(
+    () => units.some((u) => (u.status || '').trim() !== ''),
+    [units]
+  );
+
+  if (!compound) return null;
+
+  const shortNameEn = compound.nameEn || compound.code;
+  const registryWordAr = 'سجل الوحدات المتاحة';
+  const registryWordEn = 'LIVE INVENTORY REGISTRY';
+  const title =
+    isAr
+      ? `${compound.nameAr || shortNameEn} — ${registryWordAr}`
+      : isBi
+      ? `${compound.nameAr || shortNameEn} | ${shortNameEn.toUpperCase()} — ${registryWordEn}`
+      : `${shortNameEn.toUpperCase()} — ${registryWordEn}`;
+
+  const eyebrow =
+    isAr
+      ? `${units.length.toLocaleString()} وحدة — بيانات مباشرة`
+      : isBi
+      ? `${units.length.toLocaleString()} UNITS · وحدات — LIVE`
+      : `${units.length.toLocaleString()} UNITS — LIVE`;
+
+  const t = {
+    code: isAr ? 'كود الوحدة' : 'UNIT CODE',
+    type: isAr ? 'النوع' : 'TYPE',
+    bua: isAr ? 'مساحة البناء' : 'BUA m²',
+    price: isAr ? 'السعر' : 'PRICE',
+    status: isAr ? 'الحالة' : 'STATUS',
+    inspect: isAr ? 'معاينة ٣٦٠°' : '360° INSPECTION',
+    whatsapp: isAr ? 'وسيط في أي في آي' : 'WHATSAPP VIP BROKER',
+    empty: isAr
+      ? `لا توجد وحدات مطابقة لمرشحات البحث الحالية في ${compound.nameAr || compound.nameEn}.`
+      : `No units match the current filters in ${shortNameEn}.`,
+    available: isAr ? 'متاح' : 'AVAILABLE',
+    reserved: isAr ? 'محجوز' : 'RESERVED',
+  };
+
+  // 360° INSPECTION: links to the first unit WITH real media (img), else the
+  // first unit's detail page — never an empty fake viewer (§21).
+  const inspectUnit =
+    units.find((u) => u.img && u.img.trim() !== '') ?? units[0] ?? null;
+  const inspectHref = inspectUnit
+    ? `/property/${encodeURIComponent(inspectUnit.id || inspectUnit.code)}`
+    : null;
+
+  const waText = encodeURIComponent(
+    isAr
+      ? `مرحباً سييرا العقارية، أود الاستفسار عن الوحدات المتاحة في ${compound.nameAr || compound.nameEn} (${units.length} وحدة).`
+      : `Hello Sierra Estates, I would like to ask about the live inventory in ${shortNameEn} (${units.length} units).`
+  );
+
+  return (
+    <>
+      <div
+        className="mp-registry-backdrop"
+        onClick={onClose}
+        aria-hidden="true"
+      />
+      <div
+        ref={panelRef}
+        className="mp-glass mp-registry-modal"
+        role="dialog"
+        aria-modal="true"
+        aria-label={title}
+        dir={rtl ? 'rtl' : undefined}
+        tabIndex={-1}
+      >
+        <div className="mp-registry-head">
+          <div className="mp-registry-eyebrow">
+            <span className="mp-live-dot" aria-hidden="true" />
+            {eyebrow}
+          </div>
+          <div className="mp-registry-title">
+            {isAr || isBi ? (
+              <span className="mp-ar-name">{compound.nameAr || shortNameEn}</span>
+            ) : null}
+            {isBi ? ' | ' : ''}
+            {isAr ? ` — ${registryWordAr}` : `${shortNameEn.toUpperCase()} — ${registryWordEn}`}
+          </div>
+          <button
+            type="button"
+            className="mp-registry-close"
+            onClick={onClose}
+            aria-label={isAr ? 'إغلاق' : 'Close registry'}
+          >
+            <X size={14} />
+          </button>
+        </div>
+
+        <div className="mp-registry-scroll">
+          {units.length === 0 ? (
+            <div className="mp-registry-empty">{t.empty}</div>
+          ) : (
+            <table className="mp-registry-table">
+              <thead>
+                <tr>
+                  <th>{t.code}</th>
+                  <th>{t.type}</th>
+                  <th style={{ textAlign: rtl ? 'right' : 'left' }}>{t.bua}</th>
+                  <th>{t.price}</th>
+                  {showStatusColumn && <th>{t.status}</th>}
+                </tr>
+              </thead>
+              <tbody>
+                {units.map((u) => {
+                  const statusValue = (u.status || '').trim();
+                  return (
+                    <tr
+                      key={u.id}
+                      onClick={() => onSelectUnit?.(u)}
+                      title={isAr ? 'فتح تفاصيل الوحدة' : 'Open unit details'}
+                    >
+                      <td className="mp-cell-code">
+                        <Link
+                          href={`/property/${encodeURIComponent(u.id || u.code)}`}
+                          style={{ color: 'inherit', textDecoration: 'none' }}
+                        >
+                          {u.code}
+                        </Link>
+                      </td>
+                      <td>{u.type}</td>
+                      {/* §21: unknown area stays blank — never a stand-in number */}
+                      <td className="mp-cell-num">{u.area > 0 ? u.area.toLocaleString() : ''}</td>
+                      <td className="mp-cell-price">{u.priceLabel}</td>
+                      {showStatusColumn && (
+                        <td>
+                          {statusValue ? (
+                            <span
+                              className="mp-status-pill"
+                              data-status={statusTone(statusValue)}
+                            >
+                              {statusTone(statusValue) === 'available'
+                                ? t.available
+                                : statusTone(statusValue) === 'reserved'
+                                ? t.reserved
+                                : statusValue}
+                            </span>
+                          ) : null}
+                        </td>
+                      )}
+                    </tr>
+                  );
+                })}
+              </tbody>
+            </table>
+          )}
+        </div>
+
+        <div className="mp-registry-foot">
+          {inspectHref ? (
+            <Link href={inspectHref} className="mp-cta mp-cta-ghost">
+              <RotateCw size={13} />
+              {t.inspect}
+            </Link>
+          ) : null}
+          <a
+            className="mp-cta mp-cta-primary"
+            href={`https://wa.me/201092048333?text=${waText}`}
+            target="_blank"
+            rel="noopener noreferrer"
+          >
+            <MessageCircle size={13} />
+            {t.whatsapp}
+          </a>
+        </div>
+      </div>
+    </>
+  );
+}
