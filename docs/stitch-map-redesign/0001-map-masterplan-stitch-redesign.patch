+import { describe, it, expect } from 'vitest';
+import * as fs from 'fs';
+import * as path from 'path';
+import { NEW_CAIRO_COMPOUNDS } from '../apps/sierra-estates-realty/components/Maps/compounds-data';
+
+/**
+ * Masterplan 4-Variant Map Redesign (Stitch project 2455613122012383700)
+ * ----------------------------------------------------------------------------
+ * Contract tests for the /properties map experience redesign:
+ * theme (Light/Dark) × language (EN/AR/Bilingual) variant system, the
+ * Inventory Registry Modal, proximity magnification, persistence — and the
+ * §21 no-fabrication law (zero Stitch demo values in shipped code).
+ */
+describe('Masterplan Map Redesign — Variant System & Wiring', () => {
+  const ROOT_DIR = path.resolve(__dirname, '..');
+  const APP_DIR = path.join(ROOT_DIR, 'apps', 'sierra-estates-realty');
+  const PAGE_PATH = path.join(APP_DIR, 'app', '(site)', 'properties', 'PropertiesPage.tsx');
+  const LIVEMAP_PATH = path.join(APP_DIR, 'components', 'Maps', 'LiveMap.tsx');
+  const MODAL_PATH = path.join(APP_DIR, 'components', 'Maps', 'InventoryRegistryModal.tsx');
+  const CSS_PATH = path.join(APP_DIR, 'app', 'site-styles', 'masterplan.css');
+  const TYPOGRAPHY_PATH = path.join(APP_DIR, 'app', 'tokens', 'typography.css');
+
+  const read = (p: string) => fs.readFileSync(p, 'utf-8');
+  const pageSrc = read(PAGE_PATH);
+  const mapSrc = read(LIVEMAP_PATH);
+  const modalSrc = read(MODAL_PATH);
+  const cssSrc = read(CSS_PATH);
+
+  describe('Variant matrix — 4 Stitch screens as one page, two toggles', () => {
+    it('should ship the masterplan chrome + bilingual lang extension on LiveMap', () => {
+      expect(mapSrc).toContain("export type MapLang = 'en' | 'ar' | 'bi'");
+      expect(mapSrc).toContain("export type MapChrome = 'classic' | 'masterplan'");
+      expect(mapSrc).toContain('chrome = ');
+      // The page (not the engine) selects the masterplan chrome
+      expect(pageSrc).toContain('chrome="masterplan"');
+    });
+
+    it('should render BOTH toggles in the page chrome (theme × language)', () => {
+      // Theme toggle: Light / Dark pills driven by mapTheme state
+      expect(pageSrc).toContain("const [mapTheme, setMapTheme] = useState<'light' | 'dark'>");
+      expect(pageSrc).toContain("setMapTheme('light')");
+      expect(pageSrc).toContain("setMapTheme('dark')");
+      // Language toggle: EN / ع / AR|EN pills driven by mapLang state
+      expect(pageSrc).toContain('const [mapLang, setMapLang] = useState<MapLang>');
+      expect(pageSrc).toContain("setMapLang('en')");
+      expect(pageSrc).toContain("setMapLang('ar')");
+      expect(pageSrc).toContain("setMapLang('bi')");
+      expect(pageSrc).toContain('AR|EN');
+    });
+
+    it('should persist both toggles via the site preference pattern', () => {
+      expect(pageSrc).toContain("'hzp-map-theme'");
+      expect(pageSrc).toContain("'hzp-map-lang'");
+      expect(pageSrc).toContain("localStorage.setItem('hzp-map-theme', mapTheme)");
+      expect(pageSrc).toContain("localStorage.setItem('hzp-map-lang', mapLang)");
+    });
+
+    it('should scope both theme token sets in masterplan.css', () => {
+      expect(cssSrc).toContain("[data-map-theme='light']");
+      expect(cssSrc).toContain("[data-map-theme='dark']");
+      // Alexandria light primary + nocturnal void, from the Stitch renders
+      expect(cssSrc).toContain('--mp-glass: rgba(255, 255, 255, 0.85)');
+      expect(cssSrc).toContain('--mp-glass: rgba(16, 24, 40, 0.85)');
+      expect(cssSrc).toContain('--mp-gold: #ffd700');
+    });
+
+    it('should default to the map-first wide layout (order v2)', () => {
+      expect(pageSrc).toContain("useState<ViewMode>('map')");
+    });
+  });
+
+  describe('Proximity magnification & registry modal (owner interactions)', () => {
+    it('should implement zoom-driven label scaling tiers (11 / 13 / 16 px)', () => {
+      expect(mapSrc).toContain('zoom >= 14 ? 16 : zoom >= 12 ? 13 : 11');
+      expect(mapSrc).toContain('se-mp-focus');
+      expect(mapSrc).toContain('focusedCompoundCode');
+    });
+
+    it('should ship the Inventory Registry Modal wired to the full live feed', () => {
+      expect(fs.existsSync(MODAL_PATH)).toBe(true);
+      expect(pageSrc).toContain('registryUnits={registryUnits}');
+      expect(mapSrc).toContain('registryUnits');
+      expect(mapSrc).toContain('InventoryRegistryModal');
+    });
+
+    it('should render real columns only — PLOT dropped, STATUS conditional', () => {
+      expect(modalSrc).toContain('UNIT CODE');
+      expect(modalSrc).toContain('BUA m²');
+      expect(modalSrc).not.toContain('PLOT m²');
+      expect(modalSrc).toContain('showStatusColumn');
+    });
+
+    it('should use the real WhatsApp number and real detail-page links', () => {
+      expect(modalSrc).toContain('wa.me/201092048333');
+      expect(modalSrc).toContain('/property/');
+    });
+  });
+
+  describe('Bilingual labels from compounds-data (§21 real source)', () => {
+    it('should render the Stitch `العربية | LATIN` bilingual pill pattern', () => {
+      expect(mapSrc).toContain('shortEn.toUpperCase()');
+      expect(mapSrc).toContain('`${ar} | ${shortEn.toUpperCase()}`');
+    });
+
+    it('should keep every compound carrying BOTH nameEn and nameAr', () => {
+      for (const c of NEW_CAIRO_COMPOUNDS) {
+        expect(c.nameEn.trim().length).toBeGreaterThan(0);
+        expect(c.nameAr.trim().length).toBeGreaterThan(0);
+      }
+    });
+  });
+
+  describe('§21 NO-FABRICATION — zero Stitch demo values in shipped code', () => {
+    it('should contain none of the renders\' placeholder numbers or unit codes', () => {
+      const forbidden = [
+        'VLT-VL-014',
+        'VLT-TH-203',
+        'VLT-SK-108',
+        '18 UNITS',
+        '32.3M',
+        '19.8M',
+        '24.2M',
+        '11,017',
+        '85,000',
+        '17.78',
+      ];
+      const shippedSources = [pageSrc, mapSrc, modalSrc, cssSrc];
+      for (const src of shippedSources) {
+        for (const needle of forbidden) {
+          expect(src.includes(needle)).toBe(false);
+        }
+      }
+    });
+
+    it('should never hotlink ephemeral Stitch/Aida CDN assets', () => {
+      const shippedSources = [pageSrc, mapSrc, modalSrc, cssSrc];
+      for (const src of shippedSources) {
+        expect(src.includes('stitch.withgoogle.com')).toBe(false);
+        expect(src.includes('lh3.googleusercontent.com')).toBe(false);
+        expect(src.includes('aida/')).toBe(false);
+      }
+    });
+
+    it('should compute HUD metrics live and omit non-computable rows', () => {
+      expect(pageSrc).toContain('priceIndex: number | null = null');
+      expect(pageSrc).toContain('benchmark.priceIndex != null');
+      expect(pageSrc).toContain('benchmark.verifiedUnits > 0');
+    });
+  });
+
+  describe('Typography — Alexandria faces extend the site import', () => {
+    it('should add Noto Serif + Public Sans to the existing Google Fonts import', () => {
+      const typo = read(TYPOGRAPHY_PATH);
+      expect(typo).toContain('family=Noto+Serif');
+      expect(typo).toContain('family=Public+Sans');
+      expect(typo).toContain('display=swap');
+      expect(typo).toContain('--font-headline');
+      expect(typo).toContain('--font-label');
+      // Cairo (Arabic geometric sans) must stay shipped for AR labels
+      expect(typo).toContain('family=Cairo');
+    });
+  });
+});
