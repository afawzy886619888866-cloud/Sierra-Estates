@echo off
title Sierra Estates - Tunnel (Window 2)
rem ============================================================
rem  Start-SierraTunnel-v2.bat  -  SELF-CONTAINED, ONE file.
rem  No .ps1 companion needed anymore. Double-click this file.
rem  It starts the Cloudflare quick tunnel to the WhatsApp
rem  worker (localhost:2785), then COPIES your tunnel URL to
rem  the clipboard automatically. KEEP THIS WINDOW OPEN -
rem  minimize it, do not close it. It IS the tunnel.
rem ============================================================
powershell -NoProfile -ExecutionPolicy Bypass -Command "$l = Get-Content -LiteralPath '%~f0'; $i = ($l | Select-String -SimpleMatch ('#PS'+'START') | Select-Object -First 1).LineNumber; if (-not $i) { exit 1 }; $l[$i..($l.Count-1)] | Set-Content -LiteralPath ($env:TEMP + '\sierra-tunnel-v2.ps1') -Encoding UTF8"
if errorlevel 1 goto fail
powershell -NoProfile -ExecutionPolicy Bypass -File "%TEMP%\sierra-tunnel-v2.ps1"
exit /b
:fail
echo.
echo Could not prepare the helper script.
echo Please re-download this file and try again.
echo.
pause
exit /b 1
#PSSTART
# Auto-extracted payload - do not edit this file by hand.
$ErrorActionPreference = 'Continue'

$err  = Join-Path $env:USERPROFILE 'sierra-tunnel.err.log'
$out  = Join-Path $env:USERPROFILE 'sierra-tunnel.out.log'
$save = Join-Path $env:USERPROFILE 'sierra-tunnel-url.txt'
Remove-Item $err, $out -ErrorAction SilentlyContinue

Write-Host ''
Write-Host '======================================================' -ForegroundColor Cyan
Write-Host ' Sierra Estates - Cloudflare Tunnel (Window 2)'        -ForegroundColor Cyan
Write-Host ' v2 - single-file edition'                            -ForegroundColor DarkCyan
Write-Host '======================================================' -ForegroundColor Cyan
Write-Host ''
Write-Host 'Starting cloudflared and looking for your tunnel URL...'
Write-Host 'Keep this window OPEN - it IS the tunnel.' -ForegroundColor Yellow
Write-Host ''

try {
    $r = Invoke-WebRequest -Uri 'http://localhost:2785/api/health' -TimeoutSec 5 -UseBasicParsing
    Write-Host ('Window 1 worker check: HTTP ' + $r.StatusCode + ' - RUNNING') -ForegroundColor Green
} catch {
    $code = $null
    try { $code = [int]$_.Exception.Response.StatusCode } catch {}
    if ($code) {
        Write-Host ('Window 1 worker check: HTTP ' + $code + ' (reachable but unusual)') -ForegroundColor Yellow
    } else {
        Write-Host 'Window 1 worker check: NOT RESPONDING on port 2785' -ForegroundColor Red
    }
    Write-Host 'The tunnel still works - also start start-openwa-8lines.bat' -ForegroundColor Yellow
}
Write-Host ''

$cf = $null
try {
    $cf = Start-Process cloudflared -ArgumentList 'tunnel','--url','http://localhost:2785' -RedirectStandardError $err -RedirectStandardOutput $out -NoNewWindow -PassThru
} catch {
    Write-Host ''
    Write-Host 'ERROR: cloudflared was NOT found on this PC.' -ForegroundColor Red
    Write-Host 'The tunnel program is not installed.' -ForegroundColor Red
    Write-Host 'Fix: open PowerShell and run:  winget install Cloudflare.cloudflared' -ForegroundColor Yellow
    Write-Host 'Then double-click this file again.' -ForegroundColor Yellow
    Read-Host 'Press Enter to close'
    exit 1
}

$url = $null
for ($i = 0; $i -lt 240 -and -not $url -and -not $cf.HasExited; $i++) {
    Start-Sleep -Milliseconds 500
    foreach ($f in @($err, $out)) {
        if (Test-Path $f) {
            $m = Select-String -Path $f -Pattern 'https://(?!api\.)[a-zA-Z0-9][a-zA-Z0-9-]*\.trycloudflare\.com' -ErrorAction SilentlyContinue | Select-Object -First 1
            if ($m) { $url = $m.Matches[0].Value; break }
        }
    }
}

if ($url) {
    try { Set-Clipboard -Value $url } catch {}
    try { Set-Content -Path $save -Value $url -Encoding ASCII } catch {}
    Write-Host ''
    Write-Host '  =============================================================' -ForegroundColor Green
    Write-Host '   YOUR TUNNEL URL  (already copied to your clipboard):'      -ForegroundColor Green
    Write-Host "   $url"                                                     -ForegroundColor Yellow
    Write-Host '  =============================================================' -ForegroundColor Green
    Write-Host ''
    Write-Host '   NEXT STEP: go to the chat, press Ctrl+V, then Enter.'     -ForegroundColor Cyan
    Write-Host ('   (backup copy saved to: ' + $save + ')')                  -ForegroundColor DarkGray
    Write-Host '   Keep this window OPEN - minimize it.'                     -ForegroundColor Cyan
} else {
    Write-Host ''
    Write-Host 'No trycloudflare.com URL was found.' -ForegroundColor Red
    if ($cf.HasExited) {
        Write-Host 'cloudflared exited unexpectedly - see the log:' -ForegroundColor Red
    } else {
        Write-Host 'Nothing after 2 minutes - see the log:' -ForegroundColor Red
    }
    Write-Host ('   ' + $err) -ForegroundColor Gray
    Write-Host ('   ' + $out) -ForegroundColor Gray
}

Write-Host ''
Write-Host '(Tunnel running in this window - do not close it.)' -ForegroundColor DarkGray
try { Wait-Process -Id $cf.Id } catch {}
