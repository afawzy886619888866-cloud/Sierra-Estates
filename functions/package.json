{
  "name": "sierra-estates-functions",
  "version": "1.0.0",
  "description": "Firebase Cloud Functions — data collection and processing pipeline",
  "main": "lib/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "test:ci": "jest --ci --passWithNoTests",
    "deploy": "npm run build && firebase deploy --only functions"
  },
  "dependencies": {
    "firebase-admin": "^14.3.0",
    "firebase-functions": "^7.3.0"
  },
  "devDependencies": {
    "@types/jest": "^30",
    "@types/node": "^26.2.0",
    "jest": "^30",
    "ts-jest": "^29",
    "typescript": "^5.8.2"
  },
  "private": true
}
