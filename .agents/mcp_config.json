{
  "mcpServers": {
    "amphion-command-deck": {
      "command": "python",
      "args": [
        ".amphion/command-deck/scripts/mcp-bridge.py"
      ],
      "env": {}
    },
    "sierra-estates": {
      "command": "npx",
      "args": [
        "tsx",
        "scripts/sierra-mcp-server.ts"
      ],
      "env": {}
    },
    "ruflo": {
      "command": "cmd.exe",
      "args": [
        "/c",
        "ruflo",
        "mcp",
        "start"
      ],
      "env": {}
    }
  }
}
