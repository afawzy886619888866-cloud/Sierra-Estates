{
	"name": "@sierra-estates/api",
	"version": "1.0.0",
	"description": "Shared API types and clients",
	"main": "src/index.ts",
	"types": "src/index.ts",
	"private": true,
	"exports": {
		".": "./src/index.ts",
		"./types": "./src/types/index.ts",
		"./clients": "./src/clients/index.ts"
	},
	"dependencies": {
		"@sierra-estates/agents": "workspace:*",
		"axios": "^1.19",
		"express": "^5.2",
		"pino": "^10.3",
		"twilio": "^6.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@types/express": "^5.0",
		"@types/node": "^26",
		"typescript": "^5.8.2"
	},
	"Transform": "AWS::Serverless-2016-10-31",
	"Resources": {
		"Function": {
			"Type": "AWS::Serverless::Function",
			"Properties": {
				"Description": {
					"Fn::Sub": [
						"Stack ${AWS::StackName} Function ${ResourceName}",
						{
							"ResourceName": "Function"
						}
					]
				},
				"CodeUri": "src/Function",
				"Handler": "index.handler",
				"Runtime": "nodejs22.x",
				"MemorySize": 3008,
				"Timeout": 30,
				"Tracing": "Active"
			}
		},
		"FunctionLogGroup": {
			"Type": "AWS::Logs::LogGroup",
			"DeletionPolicy": "Retain",
			"Properties": {
				"LogGroupName": {
					"Fn::Sub": "/aws/lambda/${Function}"
				}
			}
		}
	}
}