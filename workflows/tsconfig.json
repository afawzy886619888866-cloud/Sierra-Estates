{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "types": ["node", "vitest/globals"],
    // The runtime files here are hand-written JavaScript (see package.json's
    // `node 01-whatsapp-scraper/index.js`); the only .ts is the test. Without
    // this, `tsc -p workflows` emitted workflows/__tests__/workflows.test.js
    // beside its source, which Jest would then collect as a second, broken
    // copy of that suite. Nothing consumes emitted output from this project.
    "noEmit": true
  },
  "include": ["**/*.ts"]
}
