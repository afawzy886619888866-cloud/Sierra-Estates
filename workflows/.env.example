# ==============================================================================
# Sierra Estates — Unified Workflows & Automation Environment Template
# Save as: workflows/.env  (NEVER commit real secrets to Git)
# ==============================================================================

# --- Supabase (Single Source of Truth) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Sheets Two-Way Sync (Workflows 08 & 14) ---
# Paste single-line minified JSON or path to service-account.json outside repo
GOOGLE_SERVICE_ACCOUNT_JSON=
MASTER_INVENTORY_SHEET_ID=
REQUESTS_SHEET_ID=
CAREERS_SHEET_ID=
APPS_SCRIPT_WEBHOOK_URL=

# --- Internal Services & n8n Security ---
N8N_WEBHOOK_SECRET=replace-with-strong-random-hex
PYTHON_API_URL=http://localhost:8000
OPENWA_GATEWAY_URL=http://localhost:2785
WORKFLOW_RUNNER_URL=http://localhost:2786
ADMIN_BRIDGE_URL=http://localhost:2790
ADMIN_API_KEY=

# --- AI & ML Models ---
GEMINI_API_KEY=
ML_MODEL_DIR=/tmp/sierra_models

# --- Property Finder Atlas API (Workflow 17 & W2) ---
PF_API_KEY=
PF_API_SECRET=
PF_BASE_URL=https://atlas.propertyfinder.com

# --- Owner Search (Workflow 02) ---
SERPAPI_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# --- Email Campaigns (Workflow 04) ---
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=hello@sierrablue.sbs

# --- WhatsApp Business Cloud API & OpenWA Multi-Session ---
WHATSAPP_CLOUD_API_URL=https://graph.facebook.com/v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# --- Telegram Alerts & Admin Bot ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
