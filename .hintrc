{
  "extends": [
    "development"
  ],
  "hints": {
    "compat-api/css": [
      "default",
      {
        "ignore": [
          "text-wrap",
          "text-wrap: balance",
          "scrollbar-width",
          "scrollbar-color",
          "backdrop-filter",
          "field-sizing"
        ]
      }
    ],
    "compat-api/html": [
      "default",
      {
        "ignore": [
          "iframe[referrerpolicy=no-referrer-when-downgrade]",
          "iframe[referrerpolicy]"
        ]
      }
    ],
    "no-inline-styles": "off"
  },
  "ignoredUrls": [
    "**/public/client-page/.min/**",
    "**/.min/**",
    "**/client-page/.min/**",
    "**/deploy/**",
    "**/.next/**",
    "**/node_modules/**",
    "**/out/**",
    "**/dist/**"
  ]
}