{
  "extends": [
    "development"
  ],
  "hints": {
    "compat-api/css": [
      "default",
      {
        "ignore": [
          "text-wrap",
          "text-wrap: balance",
          "scrollbar-width",
          "scrollbar-width: none",
          "scrollbar-color",
          "backdrop-filter",
          "field-sizing",
          "text-size-adjust",
          "text-size-adjust: 100%",
          "-webkit-text-size-adjust",
          "-webkit-text-size-adjust: 100%"
        ]
      }
    ],
    "compat-api/html": [
      "default",
      {
        "ignore": [
          "iframe[referrerpolicy=no-referrer-when-downgrade]",
          "iframe[referrerpolicy]"
        ]
      }
    ],
    "no-inline-styles": "off"
  },
  "ignoredUrls": [
    { "domain": ".*\\.min\\..*", "hints": ["all"] },
    { "domain": ".*/_next/.*", "hints": ["all"] },
    { "domain": ".*/\\.next/.*", "hints": ["all"] },
    { "domain": ".*/node_modules/.*", "hints": ["all"] },
    { "domain": ".*/dist/.*", "hints": ["all"] },
    { "domain": ".*/out/.*", "hints": ["all"] },
    { "domain": ".*/deploy/.*", "hints": ["all"] },
    { "domain": ".*/public/client-page/.*", "hints": ["all"] }
  ]
}