{
  "extends": [
    "development"
  ],
  "hints": {
    "compat-api/css": [
      "default",
      {
        "ignore": [
          "text-wrap",
          "text-wrap: balance",
          "scrollbar-width",
          "scrollbar-width: none",
          "scrollbar-color",
          "backdrop-filter",
          "field-sizing",
          "text-size-adjust",
          "text-size-adjust: 100%",
          "-webkit-text-size-adjust",
          "-webkit-text-size-adjust: 100%",
          "user-select",
          "user-select: none",
          "border-color: color-mix(in srgb, var(--gold-luxury) 55%, transparent)",
          "border: 1px solid color-mix(in srgb, var(--node-c) 40%, transparent)",
          "outline: 2px solid color-mix(in srgb, var(--gold-luxury) 70%, transparent)",
          "scrollbar-width: thin"
        ]
      }
    ],
    "compat-api/html": [
      "default",
      {
        "ignore": [
          "iframe[referrerpolicy=no-referrer-when-downgrade]",
          "iframe[referrerpolicy]",
          "meta[name=theme-color]"
        ]
      }
    ],
    "no-inline-styles": "off",
    "meta-viewport": "off"
  },
  "ignoredUrls": [
    {
      "domain": ".*\\.min\\..*",
      "hints": [
        "all"
      ]
    },
    {
      "domain": ".*/_next/.*",
      "hints": [
        "all"
      ]
    },
    {
      "domain": ".*/\\.next/.*",
      "hints": [
        "all"
      ]
    },
    {
      "domain": ".*/node_modules/.*",
      "hints": [
        "all"
      ]
    },
    {
      "domain": ".*/dist/.*",
      "hints": [
        "all"
      ]
    },
    {
      "domain": ".*/out/.*",
      "hints": [
        "all"
      ]
    },
    {
      "domain": ".*/deploy/.*",
      "hints": [
        "all"
      ]
    },
    {
      "domain": ".*/public/client-page/.*",
      "hints": [
        "all"
      ]
    },
    {
      "domain": ".*[\\\\/]docs[\\\\/]reference[\\\\/].*",
      "hints": [
        "all"
      ]
    },
    {
      "domain": ".*[\\\\/]public[\\\\/]assets[\\\\/].*",
      "hints": [
        "all"
      ]
    },
    {
      "domain": ".*tweaks-panel\\.jsx",
      "hints": [
        "all"
      ]
    },
    {
      "domain": ".*\\.jsx",
      "hints": [
        "all"
      ]
    }
  ]
}