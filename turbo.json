{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "ADMIN_HOST",
    "CLIENT_HOST",
    "COOKIE_DOMAIN",
    "FIREBASE_PROJECT_ID",
    "FIREBASE_CLIENT_EMAIL",
    "FIREBASE_PRIVATE_KEY",
    "FIREBASE_SERVICE_ACCOUNT_JSON",
    "NEXT_PUBLIC_FIREBASE_API_KEY",
    "NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN",
    "NEXT_PUBLIC_FIREBASE_PROJECT_ID",
    "NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET",
    "NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID",
    "NEXT_PUBLIC_FIREBASE_APP_ID",
    "NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID",
    "NEXT_PUBLIC_GEMINI_API_KEY",
    "NEXT_PUBLIC_APP_ENV",
    "SBR_SECRET_KEY",
    "CRON_SECRET",
    "ADMIN_API_KEY",
    "GOOGLE_AI_API_KEY",
    "GOOGLE_GENAI_API_KEY",
    "AI_PROVIDER",
    "GOOGLE_CLOUD_LOCATION",
    "WABA_NUMBER_1",
    "WABA_NUMBER_2",
    "WABA_NUMBER_3",
    "WABA_NUMBER_4",
    "WHATSAPP_API_TOKEN",
    "WHATSAPP_META_TOKEN",
    "WHATSAPP_PHONE_NUMBER_ID",
    "WHATSAPP_VERIFY_TOKEN",
    "BRANDING_TAG",
    "WA_ADMIN_NUMBER",
    "WA_TEAM_NUMBERS",
    "WA_PORT",
    "WA_HEADLESS",
    "WA_REPLY_GROUPS",
    "WA_REPLY_DMS",
    "GEMINI_MODEL",
    "TWILIO_ACCOUNT_SID",
    "TWILIO_AUTH_TOKEN",
    "TWILIO_MESSAGING_SERVICE_SID",
    "TELEGRAM_BOT_TOKEN",
    "TELEGRAM_CHAT_ID",
    "TELEGRAM_WEBHOOK_SECRET",
    "UPSTASH_REDIS_REST_URL",
    "UPSTASH_REDIS_REST_TOKEN",
    "AIRTABLE_API_KEY",
    "AIRTABLE_BASE_ID",
    "GOOGLE_SHEETS_ID",
    "MASTER_SHEET_ID",
    "BROKER_INBOX_SHEET_ID",
    "ALLOWED_ORIGINS",
    "PROPERTY_FINDER_API_GATEWAY",
    "PROPERTY_FINDER_API_KEY",
    "PROPERTY_FINDER_API_SECRET",
    "PROPERTY_FINDER_CLIENT_ID",
    "PROPERTY_FINDER_CLIENT_SECRET",
    "PROPERTY_FINDER_AUTH_TOKEN",
    "PROPERTY_FINDER_API_BASE",
    "PROPERTY_FINDER_JWT_TOKEN",
    "AIRTABLE_TABLE_NAME",
    "GOOGLE_SERVICE_ACCOUNT_EMAIL",
    "GOOGLE_SERVICE_ACCOUNT_KEY",
    "ELEVENLABS_API_KEY",
    "LEILA_VOICE_ID",
    "ARIZE_SPACE_ID",
    "ARIZE_API_KEY",
    "ARIZE_PROJECT_NAME",
    "PYTHON_API_BASE_URL",
    "OPENCLAW_BASE_URL",
    "OPENCLAW_TOKEN",
    "ZAPIER_CALENDAR_WEBHOOK_URL",
    "GMAIL_USER",
    "GMAIL_PASS",
    "SESSION_SECRET",
    "VERCEL_TOKEN",
    "VERCEL_ORG_ID",
    "CLIENT_VERCEL_PROJECT_ID",
    "N8N_BASE_URL",
    "N8N_API_KEY",
    "ORCHESTRATOR_URL",
    "ORCHESTRATOR_TOKEN",
    "DEEPSEEK_API_KEY",
    "PUBSUB_TOPIC",
    "REDIS_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "apps/**/.next/**", "!.next/cache/**", "!apps/**/.next/cache/**", "dist/**", "packages/**/dist/**", "lib/**", "functions/lib/**"]
    },
    "dev": { "cache": false, "persistent": true },
    "lint": { "dependsOn": ["^lint"] },
    "type-check": { "dependsOn": ["^build"] },
    "test": { "dependsOn": ["^build"], "outputs": ["coverage/**"] },
    "test:ci": { "dependsOn": ["^build"], "outputs": ["coverage/**"] },
    "clean": { "cache": false }
  }
}
