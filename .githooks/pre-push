#!/usr/bin/env bash
#
# Runs the local quality gate before a push. Installed by `pnpm hooks:install`.
# Bypass for a genuine emergency with:  git push --no-verify
#
set -euo pipefail
printf '\033[1mRunning local quality gate (git push --no-verify to bypass)\033[0m\n'
exec "$(git rev-parse --show-toplevel)/scripts/verify.sh"
