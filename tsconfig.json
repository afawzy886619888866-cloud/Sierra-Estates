{
  "extends": "./tsconfig.base.json",
  "compileOnSave": false,
  "files": [],
  "compilerOptions": {
    "target": "ES2020",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ES2020"],
    "paths": {
      "@sierra-estates/exchange": ["./packages/exchange/exchange-client.ts", "./packages/exchange/dist/index.js"],
      "@sierra-estates/agents": ["./packages/agents/index.ts"],
      "@sierra-estates/agents-core": ["./packages/agents-core/src/index.ts"],
      "@sierra-estates/memory-engine": ["./packages/memory-engine/src/index.ts", "./packages/memory-engine/dist/index.js"],
      "@sierra-estates/obsidian": ["./packages/obsidian/src/index.ts", "./packages/obsidian/dist/index.js"],
      "@sierra-estates/db": ["./packages/db/lib/index.ts"],
      "@sierra-estates/auth": ["./packages/auth"],
      "@sierra-estates/config": ["./packages/config"]
    }
  },
  "exclude": ["node_modules", "dist", ".next"],
  "references": [
    {
      "path": "./lib/db"
    },
    {
      "path": "./lib/api-client-react"
    },
    {
      "path": "./lib/api-zod"
    },
    {
      "path": "./lib/integrations/aws"
    }
  ]
}
