commit 5a99c6ab185143cf4040723a80bcc10ed63cba4c
Author: afawzy886619888866-cloud <a.fawzy886619888866@gmail.com>
Date:   Thu Nov 12 21:02:59 2026 +0200

    fix(deploy): env-sync step actually passes the Supabase backend values (#51)
    
    The Re-sync step ran the sync with only VERCEL_TOKEN; the script silently skips unset keys, so NEXT_PUBLIC_SUPABASE_URL was never pushed to the Vercel projects and production booted without it. Step now receives the Supabase values (same secrets/vars chain as every other workflow) and fails loudly when they are absent; the script logs loud skip warnings for CRITICAL_KEYS.

diff --git a/.github/workflows/deploy-vercel.yml b/.github/workflows/deploy-vercel.yml
index 6d1c5c55e..d3273e5ee 100644
--- a/.github/workflows/deploy-vercel.yml
+++ b/.github/workflows/deploy-vercel.yml
@@ -198,10 +198,29 @@ jobs:
           done
 
       - name: Re-sync environment variables to the ${{ matrix.role }} project
+        # The sync script reads its values from process.env (see
+        # CLIENT_ENV_VARS / ADMIN_ENV_VARS) and silently skips any var that
+        # is unset ('if (!value) continue;'). This step MUST therefore be
+        # given the Supabase backend values — until 2026-11-12 it ran with
+        # nothing but VERCEL_TOKEN, so NEXT_PUBLIC_SUPABASE_URL was never
+        # re-synced and production ran without it (/api/health degraded,
+        # /api/inventory empty).
+        env:
+          NEXT_PUBLIC_SUPABASE_URL: ${{ secrets.NEXT_PUBLIC_SUPABASE_URL || vars.NEXT_PUBLIC_SUPABASE_URL || 'https://gaxfqcietzoonlmatiot.supabase.co' }}
+          SUPABASE_URL: ${{ secrets.NEXT_PUBLIC_SUPABASE_URL || vars.NEXT_PUBLIC_SUPABASE_URL || 'https://gaxfqcietzoonlmatiot.supabase.co' }}
+          NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY: ${{ secrets.NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY }}
+          NEXT_PUBLIC_SUPABASE_ANON_KEY: ${{ secrets.NEXT_PUBLIC_SUPABASE_ANON_KEY }}
+          SUPABASE_SERVICE_ROLE_KEY: ${{ secrets.SUPABASE_SERVICE_ROLE_KEY }}
         run: |
           set -euo pipefail
           VERCEL_TOKEN_VALUE="${{ secrets.VERCEL_TOKEN }}"
           [ -z "$VERCEL_TOKEN_VALUE" ] && VERCEL_TOKEN_VALUE="${{ secrets.VERCEL_AUTH_TOKEN }}"
+          # Fail loudly if the canonical backend values are absent — a sync
+          # that silently skips Supabase is how production lost them.
+          if [ -z "$NEXT_PUBLIC_SUPABASE_URL" ] || [ -z "$NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY$NEXT_PUBLIC_SUPABASE_ANON_KEY" ]; then
+            echo "::error::Supabase backend env values are missing — refusing to run a sync that would silently skip them."
+            exit 1
+          fi
           # 429 Rate limited-aware: the script itself backs off with sleeps.
           VERCEL_TOKEN="$VERCEL_TOKEN_VALUE" node scripts/sync-vercel-env.js --role ${{ matrix.role }} || {
             echo "::warning::Env sync for ${{ matrix.role }} failed — deployment stands, re-run scripts/sync-vercel-env.js manually."
diff --git a/scripts/sync-vercel-env.js b/scripts/sync-vercel-env.js
index 623ecba45..421c22645 100644
--- a/scripts/sync-vercel-env.js
+++ b/scripts/sync-vercel-env.js
@@ -246,8 +246,23 @@ export async function syncVarsToProject(projectName, projectId, envVars) {
   }
 
   // 2. Sync each var
+  // Backend values the site cannot boot without. When one of these is
+  // absent from the environment, say so LOUDLY: the silent `continue`
+  // below is how production lost NEXT_PUBLIC_SUPABASE_URL on 2026-11-12
+  // (the CI step ran the sync without passing any Supabase values, every
+  // key was skipped, and the deploy shipped without them).
+  const CRITICAL_KEYS = [
+    'NEXT_PUBLIC_SUPABASE_URL',
+    'NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY',
+  ];
+
   for (const [key, value] of Object.entries(envVars)) {
-    if (!value) continue;
+    if (!value) {
+      if (CRITICAL_KEYS.includes(key)) {
+        console.warn(`   ❌ ${key} -> NOT SET in this environment; SKIPPED (production will boot without it — pass the value to this step/script!)`);
+      }
+      continue;
+    }
 
     const existing = existingMap.get(key);
     const varType = key.includes('SECRET') || key.includes('KEY') || key.includes('JSON') || key.includes('TOKEN') || key.includes('PASSWORD') ? 'encrypted' : 'plain';

