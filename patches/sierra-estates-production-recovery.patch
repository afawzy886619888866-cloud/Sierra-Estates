+        afterByKey.get(e.key).push(e);
+      }
+      reportCriticalState();
+      let allOk = true;
+      for (const key of CRITICAL_KEYS) {
+        const copies = afterByKey.get(key) || [];
+        const prodCopy = copies.find((c) => (c.target || []).includes('production'));
+        if (!prodCopy) {
