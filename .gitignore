# ============================================================================
# Removed from repo (kept local): AI tooling artifacts & vendored dev tooling.
# Not referenced by any build, CI workflow, or runtime code. (2026-09 audit)
# ============================================================================
.amphion/
tools/claude-proxy/

# NOTE: apps/sierra-estates-realty/supabase/ is intentionally gitignored, but
# ALL files in supabase/migrations/ inside it are FORCE-TRACKED (git add -f):
# the turbo-cached build replay lstats them at their app-dir paths, and any
# traced-but-absent file breaks Vercel builds with ENOENT (observed for both
# 011/012 and the mirrored 2025*/2026* files). Canonical copies live in
# supabase/migrations/ at repo root; the prebuild mirror overwrites these app
# copies with root content at every build, so no drift is possible.
# IF YOU ADD A MIGRATION: commit it in BOTH supabase/migrations/ (canonical)
# AND apps/sierra-estates-realty/supabase/migrations/ (git add -f).
workflows/.state/
**/workflows.env
# PC auto-start boot log (ENABLE-AUTO-START.bat writes .state/autostart.log)
.state/

# Phase 1 pipeline stash (regenerated by build_master_inventory.py)
scripts/_phase1_data.json

# Sales-kit PDFs >5MB live in the Supabase 'sales-kits' public bucket —
# see docs/sales-kits/README.md for the URL manifest (2026-10-22).
docs/sales-kits/*.pdf

# ============================================================================
# Sierra Evolution desktop engine — LOCAL runtime state (never commit).
# The webhook/orchestrator run on the owner's machine; their working files
# contain owner phone numbers and checkpoint state, and the Excel ledger is a
# growing binary (repo-bloat + PII). CI uploads them as workflow artifacts
# instead of committing them. See docs/EVOLUTION_WHATSAPP_RUNBOOK.md.
# ============================================================================
sierra_checkpoint.json
sierra_checkpoint.json.tmp
Sierra_Estates_Master_Units.xlsx
.env.sierra*
pair_*.html

# Ephemeral WhatsApp QR codes
apps/agents/whatsapp-multi-session/qr_*.png
apps/agents/whatsapp-multi-session/.tmp/

# Large multi-MB Property Finder bulk XML drafts (generated locally / CI artifacts;
# canonical tracked sample propertyfinder-feed.xml stays <5MB per git-weight policy)
docs/drafts/propertyfinder/propertyfinder-all-units.xml
docs/drafts/propertyfinder/propertyfinder-owners-full.xml
docs/drafts/propertyfinder/propertyfinder-photos-only.xml
docs/drafts/propertyfinder/propertyfinder-full-feed.xml
!workflows/.env.example

# Archived Agent Skills
.agents/skills-archive/

tools/autoclaw/Inbox/


apps/sierra-estates-realty/public/downloads/*.xlsx

# Quarantined dumps and raw spreadsheets
quarantine/

# ============================================================================
# 2026-11-01 secrets & dump hardening (Mission 1)
# ============================================================================
# Master secrets file — loaded first by workflows/lib/google-sheets.js
# loadWorkflowEnv() and by the compose env_file directives. NEVER commit.
infra/.secrets.env
**/infra/.secrets.env
# Raw SQL dumps: a blanket *.sql with explicit negations for the tracked
# migration sources (already-tracked files are unaffected by ignore rules;
# the negations keep `git add` working for NEW migrations).
*.sql
!supabase/migrations/**/*.sql
!infra/supabase/migrations/**/*.sql
!packages/open-memory/**/*.sql
!schema.sql
!apps/sierra-estates-realty/supabase/schema.sql
!apps/sierra-estates-realty/supabase/tests/*.sql
# NOTE: apps/sierra-estates-realty/supabase/migrations/ is ignored by the
# apps/ rule above on purpose — its files are FORCE-ADDED (git add -f) per
# the documented mirror workflow; the *.sql blanket does not change that.
# Tracked runtime artifacts of local AI tooling — never commit.
.node-persist/
.playwright-mcp/
.reports/

ANTIGRAVITY-PROMPT-*.md
Activate-WhatsAppGateway.ps1
