# ==============================================================================
# Sierra Estates — Comprehensive Git Ignore Policy
# ==============================================================================

# Dependencies
node_modules/
.pnpm-store/
.pnpmrc

# Next.js & Turborepo build outputs
.next/
out/
build/
dist/
.turbo/
graphify-out/

# Vercel CLI cache & local configs
.vercel/

# TypeScript cache & compiled twins
*.tsbuildinfo
apps/sierra-estates-realty/lib/**/*.js
apps/sierra-estates-realty/components/**/*.js
apps/sierra-estates-realty/app/**/*.js
apps/sierra-estates-realty/__tests__/**/*.js

# Environment variables & secrets (CRITICAL: NEVER COMMIT SECRETS)
.env
.env.local
.env.*.local
**/.env
**/.env.local
**/.env.*.local
apps/agents/**/.env
apps/agents/**/.env.*
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
id_rsa*
id_ed25519*
*aws_credentials*

# WhatsApp, OpenWA & Container runtime data
**/openwa-data/
**/whatsapp-auth/
**/n8n-data/
**/wa_sessions/
**/.wwebjs_auth/
**/.wwebjs_cache/
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm

# Python & Virtual Environments
venv/
.venv/
__pycache__/
*.py[cod]
*$py.class
*.pkl
.pytest_cache/
.coverage
htmlcov/

# Logs & Diagnostics
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
scratch/

# OS & Editor artifacts
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/extensions.json
*.swp
*.swo
*~
.~lock*

# Archives & Temporary Dumps
*.zip
*.tar.gz
*.tgz
*.rar
*.7z
*.tmp
*.bak
testrun/
output/
work-items-out/
temp/
.rpa/

# Jupyter
.ipynb_checkpoints/
.virtual_documents/

# Bruin / Tools
.bruin.yml

# Test coverage & nested worktrees / agent workspaces
coverage/
**/coverage/
.amazonq/
.claude/settings.local.json
SE-Vercel-deploy-main*/
tools/deer-flow/
tools/openai-agents-python/