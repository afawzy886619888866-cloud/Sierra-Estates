# =====================================================
# Sierra Estates — Environment Variables Template
# Copy to .env.local and fill in values.
# NEVER commit .env.local to version control.
#
# This file is the canonical list of variables the app reads.
# Authoritative Backend: Supabase (PostgreSQL / Storage / Auth)
# =====================================================

# ─── Supabase (Sole Authoritative Backend) ───
NEXT_PUBLIC_SUPABASE_URL=https://gaxfqcietzoonlmatiot.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROPERTY_MEDIA_BUCKET=property-media
SUPABASE_MEDIA_BUCKET=media

# ─── Legacy Deployments (Permanently Retired) ───
# Firebase is permanently retired. All tables, auth, and media live in Supabase.

# ─── Internal auth / service secrets ───
# SBR_SECRET_KEY is the shared secret checked by lib/server/auth-guard.ts
# (X-SBR-SECRET-KEY header / Bearer) for service + webhook callers.
SBR_SECRET_KEY=
CRON_SECRET=
# Admin API key for /api/houyez/seed and other admin-only Next.js routes on
# the root client-portal shell (src/). Generate with: openssl rand -hex 32
# Generate with: openssl rand -hex 32. Leave EMPTY rather than copying a
# placeholder — a shipped placeholder is a known-value admin key.
ADMIN_API_KEY=
ANTIGRAVITY_API_KEY=

# ─── Session signing & webhook secrets (REQUIRED in production) ───
# SESSION_SECRET signs the admin session cookie (lib/auth.ts). Production
# refuses to sign sessions without it — there is deliberately no fallback.
# Generate with: openssl rand -hex 32
SESSION_SECRET=
# HMAC-SHA256 secret for the Property Finder webhook
# (app/api/webhooks/property-finder). Unset in production => 503, never open.
PF_WEBHOOK_SECRET=
# Bootstrap admin login (lib/auth.ts). Leave both empty to disable that path.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
# Partner accounts (merged-in property accounts — role 'partner').
# These users log into the admin portal at /admin and see ONLY Inventory,
# Ad Listing and CRM, filtered server-side to their own portfolio
# (developers + compounds). JSON, single object or array; read per-call so
# credentials can rotate without a re-import. Unset/malformed => ZERO
# partner accounts (fail closed — same doctrine as ADMIN_BOOTSTRAP_PASSWORD).
# Durable alternative: create Supabase Auth users, set profiles.role='partner'
# and profiles.metadata.partner_scope (migration 20261002_019).
# Example:
# PARTNER_ACCOUNTS=[{"email":"partner1@example.com","password":"strong-pass-1","name":"Partner One","developers":["Mountain View"],"compounds":["iCity"]},{"email":"partner2@example.com","password":"strong-pass-2","name":"Partner Two","developers":["Emaar"],"compounds":["Mivida"]}]
PARTNER_ACCOUNTS=
# Comma-separated origins allowed by lib/server/cors.ts, and the cookie domain
# shared between the client portal and the admin host.
ALLOWED_ORIGINS=
COOKIE_DOMAIN=

# ─── AI / Gemini ───
GOOGLE_AI_API_KEY=
GOOGLE_GENAI_API_KEY=
# Selects the AI provider implementation in lib/ai.
AI_PROVIDER=
# Vertex AI (agents-core PropertyMatcherAgent — IAM/ADC auth, no API key).
# Requires GOOGLE_APPLICATION_CREDENTIALS or Workload Identity locally/in CI.
GOOGLE_CLOUD_LOCATION=europe-west1

# ─── WhatsApp — bulk outreach senders (4 dedicated numbers) ───
WABA_NUMBER_1=
WABA_NUMBER_2=
WABA_NUMBER_3=
WABA_NUMBER_4=
# Meta WhatsApp Cloud API (inbound webhook + any Cloud-API sends)
WHATSAPP_API_TOKEN=
WHATSAPP_META_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
# Self-hosted OpenWA gateway (github.com/rmyndharis/OpenWA) — PRIMARY outbound
# transport when set; replaces Twilio/Meta Cloud-API sending with your own
# WhatsApp Web session (QR-paired). Install/runbook: services/openwa/README.md
#   WHATSAPP_API_URL  e.g. http://<gateway-host>:2785
#   WHATSAPP_API_TOKEN  an OpenWA API key (gateway → API Keys)
#   OPENWA_SESSION_ID   session id created in the gateway (default: session-default)
WHATSAPP_API_URL=
OPENWA_SESSION_ID=session-default
# Branding suffix appended to outbound owner-outreach templates.
BRANDING_TAG=

# ─── AWS / Cloud Integration (Bedrock / SNS / OpenMemory / EC2 / Lambda) ───
# Use for AWS Bedrock embeddings, Amazon SNS notification services, or the
# EC2/Lambda helpers in lib/integrations/aws (@workspace/aws)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ─── WhatsApp — Twilio (outbound sending; wired in Phase 4) ───
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Either a Messaging Service SID, or per-sender SIDs aligned with WABA_NUMBER_*.
TWILIO_MESSAGING_SERVICE_SID=

# ─── Telegram (high-priority alerts + webhook) ───
# TELEGRAM_BOT_TOKEN: Get from @BotFather (https://t.me/botfather)
# TELEGRAM_CHAT_ID: The chat ID to receive alerts; sent by /start command to the bot
# TELEGRAM_WEBHOOK_SECRET: Generated via `openssl rand -hex 32`; protects the webhook
# Must be registered with Telegram's setWebhook API before deployment
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# Upstash Redis (distributed rate-limiting; lib/server/rate-limit.ts).
# When BOTH are set, public endpoints use a shared Redis counter across all
# serverless instances. When unset, the limiter falls back to a per-instance
# in-memory counter (looser under load, but never blocks on a Redis outage).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# n8n Workflow Engine
N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=


# ─── Vercel Deployment & Build Tokens ───
# Get this from your personal Vercel Account Settings -> Tokens
VERCEL_TOKEN=
# Get this from Vercel Team Settings -> General -> Organization ID
VERCEL_ORG_ID=
# The Project ID for your Client Portal (e.g., sierra-estates.net)
CLIENT_VERCEL_PROJECT_ID=
# The Project ID for your Admin Portal (e.g., admin.sierra-estates.net)
ADMIN_VERCEL_PROJECT_ID=

# --- App ---
# Used for absolute links / redirects. In Vercel this is set automatically, but set it for local dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Executive / Contact (lib/config.ts — never hardcode PII) ───
EXEC_NAME=
EXEC_ROLE=
EXEC_PHONE=
EXEC_EMAIL=
EXEC_TELEGRAM_BOT_URL=
CONTACT_WHATSAPP=
CONTACT_MAIN_OFFICE=Cairo, Egypt

# ─── Inventory map (Google Sheet → /api/inventory, master-sheet-sync) ───
# The owner-inventory sheet published as CSV feeds the live inventory map.
# Defaults to the production sheet; override to point at a different sheet/tab.
# Only unit facts are read — owner name/mobile columns are never exposed publicly.
INVENTORY_SHEET_ID=
INVENTORY_SHEET_GID=
MASTER_SHEET_ID=

# ─── Session / Cookie Security ───
# Required in production — generate with: openssl rand -hex 32
SESSION_SECRET=

# ─── Python FastAPI Service (Cloud Run) ───
# Set to your Cloud Run service URL after deploying apps/api
PYTHON_API_URL=http://localhost:8000

# ─── Google Cloud ───
GOOGLE_CLOUD_PROJECT=sierra-blu

# ─── PropertyFinder API ───
PROPERTY_FINDER_API_KEY=
PROPERTY_FINDER_API_SECRET=
PROPERTY_FINDER_WEBHOOK_SECRET=
# PHASE 4: when true, PFIntegrationService.publishListing() validates the
# 8-condition publish gate + provider field contract but never calls the
# remote PF API (controlled live test / dry-run mode).
PF_DRY_RUN=

# ─── Admin Bootstrap (dev-only fallback when Supabase Auth is not initialized) ───
ADMIN_BOOTSTRAP_EMAIL=admin@sierra-estates.net
ADMIN_BOOTSTRAP_PASSWORD=
# PHASE 7: inbox notified when an unprovisioned Google identity requests
# staff access (durable request is recorded regardless; approval itself is
# super-admin-only in the admin queue).
ADMIN_APPROVAL_EMAIL=

# ─── Found used in code but previously undocumented anywhere (2026-08-24 audit) ───
# Airtable — packages/api/whatsapp-webhook.ts. Entire integration had zero config docs.
# Base "Inventory Management System" (2026-08-24), table schema built to match
# addListing()/batchIngestListings() in packages/agents/tools/inventoryTools.ts.
# AIRTABLE_API_KEY is a personal/service Airtable token — generate one at
# https://airtable.com/create/tokens with data.records:write scope on this base.
AIRTABLE_API_KEY=
# cspell:disable-next-line
AIRTABLE_BASE_ID=app_placeholder_base_id
AIRTABLE_TABLE_NAME=Units
# SMTP — outbound owner/lead notification email (apps/automations/src/04-email-sender).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SALES_NOTIFICATION_EMAIL=
ADMIN_ALERT_EMAIL=
# Resend — alternative email sender path (apps/automations/src/04-email-sender).
RESEND_API_KEY=
# DeepSeek harness (packages/deepseek-harness/src/harness.ts).
DEEPSEEK_API_URL=
DEEPSEEK_API_KEY=
# WhatsApp bot admin routing (apps/agents/whatsapp-bot/index.ts).
ADMIN_PHONES=
WA_ADMIN_NUMBER=
WA_TEAM_NUMBERS=

# ─── Pub/Sub Redis fallback (distinct from the Upstash REST pair above) ───
# packages/ai-orchestrator/src/pubsub-broker.ts checks REDIS_URL / KV_URL as a
# presence flag for a future long-lived Redis pub/sub connection. This is NOT
# the same as UPSTASH_REDIS_REST_URL/TOKEN: Upstash's REST API is stateless
# request/response and can't do PUBLISH/SUBSCRIBE, so it can't serve this case.
REDIS_URL=
KV_URL=
# apps/sierra-estates-realty/scripts/sync-pf-real-data.mjs.
PROPERTY_FINDER_API_GATEWAY=
