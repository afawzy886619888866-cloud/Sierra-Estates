# One-off data exports & ops leftovers
*.tsv
deploy/
docker-compose*.yml

# Jest suites: the realty app suite now RUNS inside the Vercel build
# (scripts/ci-preflight.sh gate 8), so the app's __tests__ must upload.
# Root /__tests__/ stays local-only (repo-hygiene suites, not part of the
# web build); other packages' test dirs stay excluded too.
# NOTE: negations must come AFTER the catch-all __tests__/ rule — the last
# matching pattern wins.
/__tests__/
__tests__/
!apps/sierra-estates-realty/__tests__
!apps/sierra-estates-realty/__tests__/**

# CI gate inputs: the Phase-1 pipeline sources must reach the Vercel build
# (ci-preflight gate 0 regenerates data/MASTER_INVENTORY_V1.csv from them).
# The generated CSV itself stays excluded (data/**, *.csv above).
!data/Sierra_Estates_Consolidated_Master_Inventory_All_Sheets.xlsx
!owners_rent_tab_separated.tsv
!owners_rent_with_photos.tsv

# ============================================================================
# 2026-10-15 gate-8 contract inputs (fixes sierra-estates-static-portal ERRORs)
# ============================================================================
# The realty jest suite runs INSIDE the Vercel build (ci-preflight gate 8) and
# asserts these repo-root inputs, so they must upload past the catch-all
# .agents / .vscode/ exclusions above:
#   - __tests__/mcd-workflow-extended.test.ts    -> .agents/workflows/*.md
#   - __tests__/regression-hardening.test.ts     -> .vscode/*.json
# gitignore semantics: a re-included file needs every excluded parent
# negated first, then the sibling children are re-excluded to keep the
# upload minimal (.agents/workflows is 36KB of .md contract files; the rest
# of .agents stays local-only, as do non-JSON .vscode artifacts).
!.agents
.agents/*
!.agents/workflows
!.agents/workflows/**
!.vscode
!.vscode/*.json
