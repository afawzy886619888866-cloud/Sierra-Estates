# snapshot.json must NOT be ignored: the app statically imports it
# (lib/site/data.ts, AvailabilityVerificationService), it is tracked in git as
# a seed stub, and excluding it broke turbo-cached builds whose replayed trace
# lstats the file (ENOENT) even though prebuild would create it on a cold build.
packages/whatsapp-agent/wa_sessions
packages/whatsapp-agent/*.sw_col.json

# Tool artifacts and redundant local clones
.amazonq
.amazonq/**
SE-Vercel-deploy-main*
SE-Vercel-deploy-main*/**
.reports/**
libArchive/**
stubArchive/**
.amphion/**
.claude-flow/**
.factory/**
.qwen/**
.zencoder/**
graphify-out/**
*.tsbuildinfo

# ============================================================================
# 2026-09-29 audit additions (merged on top of the original rules above)
# ============================================================================

# Legacy root public/ (10.9MB design assets) — app serves
# apps/sierra-estates-realty/public; nothing reads the root copy at build.
/public/

# Editor configs & AI-assistant artifacts not covered above
.vscode/
.claude/
.clinerules
62daec16-d1ed-444d-8d6a-d654c5b84b3e/
83de526d-6350-4890-b9b3-39794dff3894/
FUTURE_PLAN

# One-off data exports & ops leftovers
*.tsv
deploy/
docker-compose*.yml

# Jest suites: the realty app suite now RUNS inside the Vercel build
# (scripts/ci-preflight.sh gate 8), so the app's __tests__ must upload.
# Root /__tests__/ stays local-only (repo-hygiene suites, not part of the
# web build); other packages' test dirs stay excluded too.
# NOTE: negations must come AFTER the catch-all __tests__/ rule — the last
# matching pattern wins.
/__tests__/
__tests__/
!apps/sierra-estates-realty/__tests__
!apps/sierra-estates-realty/__tests__/**

# CI gate inputs: the Phase-1 pipeline sources must reach the Vercel build
# (ci-preflight gate 0 regenerates data/MASTER_INVENTORY_V1.csv from them).
# The generated CSV itself stays excluded (data/**, *.csv above).
!data/Sierra_Estates_Consolidated_Master_Inventory_All_Sheets.xlsx
!owners_rent_tab_separated.tsv
!owners_rent_with_photos.tsv
