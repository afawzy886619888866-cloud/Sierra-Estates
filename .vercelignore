83de526d-6350-4890-b9b3-39794dff3894/
FUTURE_PLAN

# One-off data exports & ops leftovers
*.tsv
deploy/
docker-compose*.yml

# Jest suites run in CI only, never inside Vercel builds
/__tests__/
__tests__/
