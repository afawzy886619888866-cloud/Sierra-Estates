{
  "name": "03-ai-score-scheduler",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 6
            }
          ]
        }
      },
      "id": "cron-trigger",
      "name": "Every 6 Hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.PYTHON_API_URL }}/api/ml/train-and-score",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-N8N-Secret",
              "value": "={{ $env.N8N_WEBHOOK_SECRET }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"min_labeled_rows\": 30,\n  \"dry_run\": false,\n  \"batch_size\": 200\n}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "http-train-score",
      "name": "Call FastAPI LightGBM Scorer",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [500, 300],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "check-ok",
              "leftValue": "={{ $json.status }}",
              "rightValue": "ok",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "if-success",
      "name": "Score Succeeded?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [760, 260]
    },
    {
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_ADMIN_CHAT_ID }}",
        "text": "=📊 *Sierra Estates AI Scoring Complete*\n• Mode: `{{ $json.mode }}`\n• Units Scored: *{{ $json.total_units_scored }}*\n• Labeled Ads Used: *{{ $json.labeled_rows_used }}*\n• Top Driver: `{{ $json.top_criteria[0]?.feature || 'N/A' }}` ({{ $json.top_criteria[0]?.share_pct || 0 }}%)",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "telegram-summary",
      "name": "Notify Admin on Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1020, 180]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/webhook_failures",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"workflow\": \"03-ai-score-scheduler\",\n  \"error_message\": {{ JSON.stringify($json.error || $json.message || 'Unknown scoring failure') }},\n  \"payload\": {{ JSON.stringify($json) }}\n}"
      },
      "id": "log-failure",
      "name": "Log Error to Supabase",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1020, 420]
    }
  ],
  "connections": {
    "Every 6 Hours": {
      "main": [
        [
          {
            "node": "Call FastAPI LightGBM Scorer",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Call FastAPI LightGBM Scorer": {
      "main": [
        [
          {
            "node": "Score Succeeded?",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Log Error to Supabase",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Score Succeeded?": {
      "main": [
        [
          {
            "node": "Notify Admin on Telegram",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Log Error to Supabase",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "timezone": "Africa/Cairo"
  }
}
