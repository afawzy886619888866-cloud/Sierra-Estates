# Copy this file to .env on the Docker host. Never commit .env.

# Public n8n URL. Use HTTPS behind a reverse proxy for production.
N8N_HOST=n8n.example.com
N8N_PORT=5678
N8N_PROTOCOL=https
WEBHOOK_URL=https://n8n.example.com
N8N_EDITOR_BASE_URL=https://n8n.example.com
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=[PASSWORD]

# Supabase is the only authoritative backend.
SUPABASE_URL=https://gaxfqcietzoonlmatiot.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# Optional workflow integrations.
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
PROPERTY_FINDER_API_KEY=
PROPERTY_FINDER_API_SECRET=
PROPERTY_FINDER_WEBHOOK_SECRET=
N8N_WEBHOOK_URL=http://n8n:5678/webhook/whatsapp-incoming

# Runtime settings.
TIMEZONE=Africa/Cairo
LOG_LEVEL=info
BOT_NAME=Sierra Estates
WHATSAPP_QR_PORT=3000

# ── RAG Station gateway keys (8-line WhatsApp pool, tunnel-exposed path) ──
# Required by infra/docker-compose.rag-station.yml: cloudflared fronts the
# gateway with a PUBLIC tunnel URL, and the legacy defaults
# (sierra-admin-secret / sierra-operator-secret) are committed in the public
# repo — anyone could drive the lines with them. Generate strong random
# values, e.g. PowerShell:
#   -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 48 | % {[char]$_})

# Full gateway control (admin). REQUIRED — compose refuses to start without it.
OPENWA_ADMIN_API_KEY=

# Send/line operator key. Optional — defaults to the admin key when unset.
OPENWA_OPERATOR_KEY=

# ──────────────────────────────────────────────────────────────────────────
# Workflow runner (infra/docker-compose.runner.yml — Docker migration of the
# EC2 runner path; see infra/DOCKER-RUNNER-MIGRATION.md)
# ──────────────────────────────────────────────────────────────────────────

# Control API key (manual triggers, workflow rows, tracker export).
# REQUIRED by the runner compose — it fails closed without a strong value:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
RUNNER_API_KEY=

# Outreach & Sheet Configuration (optional overrides — sensible defaults exist in compose)
# NOTE: the outreach lane opens 09:00 Cairo (owner requirement, PR #37).
# Leave this line out or set 9-22 — a stale 10-20/10-22 pin here would
# re-close the 9 AM lane even though the code default is 9-22.
WF_OUTREACH_ACTIVE_HOURS=9-22
WF_SLOT_BATCH=30
WF_HOST_SIDE=split
UNITS_SHEET_ID=1g9GIcCM0slC5QplgzatZRxU46O_N4CR2jgDp9DeMYZk
UNITS_SHEET_GID=1127958606
BROKER_INBOX_SHEET_ID=
WF_SHEET_WRITE_URL=
WF_SHEET_WRITE_SECRET=
GOOGLE_SERVICE_ACCOUNT_JSON=

# ── Morning briefing (07-daily-digest — 03:00 Cairo, PR #37) ──
# Where the daily 03:00 Arabic WhatsApp briefing is delivered.
# Set to the owner's number (Egyptian mobile, international format without +).
# Empty = falls back to LEAD_NOTIFY_WHATSAPP_NUMBER, then to the gateway
# session's own number ("message yourself" chat on the paired line).
WF_DIGEST_TO=201092048333
LEAD_NOTIFY_WHATSAPP_NUMBER=

# Supabase telemetry (OPTIONAL): when set, the runner writes the
# public.workflows rows that close the G3 acceptance gate. Empty = local
# scheduling + logs only (honest 'unconfigured' labels).
# NOTE: SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY are already defined in the
# n8n section above — the runner compose reads the same values; no second
# entry needed. Set them there once.
