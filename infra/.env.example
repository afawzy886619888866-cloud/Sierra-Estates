# Copy this file to .env on the Docker host. Never commit .env.

# Public n8n URL. Use HTTPS behind a reverse proxy for production.
N8N_HOST=n8n.example.com
N8N_PORT=5678
N8N_PROTOCOL=https
WEBHOOK_URL=https://n8n.example.com
N8N_EDITOR_BASE_URL=https://n8n.example.com
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=[PASSWORD]

# Supabase is the only authoritative backend.
SUPABASE_URL=https://gaxfqcietzoonlmatiot.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# Optional workflow integrations.
GEMINI_API_KEY=
PROPERTY_FINDER_WEBHOOK_SECRET=
N8N_WEBHOOK_URL=http://n8n:5678/webhook/whatsapp-incoming

# Runtime settings.
TIMEZONE=Africa/Cairo
LOG_LEVEL=info
BOT_NAME=Sierra Estates
WHATSAPP_QR_PORT=3000
