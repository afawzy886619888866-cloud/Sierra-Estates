# ==============================================================================
# Sierra Estates — MASTER SECRETS FILE (infra/.secrets.env)
# ==============================================================================
# Copy to `infra/.secrets.env` and fill on the Docker / workflow host.
#
# Loading contract (2026-11-01 hardening — Mission 1):
#   · workflows/lib/google-sheets.js#loadWorkflowEnv() reads this file FIRST,
#     so values here WIN over workflows/.env, repo .env.local and repo .env.
#   · infra/docker-compose.runner.yml + docker-compose.rag-station.yml load it
#     via `env_file` (required: false) — explicit `environment:` entries still
#     override env_file values inside the container.
#   · .gitignore blocks `infra/.secrets.env` and `**/infra/.secrets.env`;
#     only this .example template is committable.
#
# NEVER commit the filled file. Rotate any secret that ever touches a chat.
# ==============================================================================

# ── Workflow runner control plane (:2786) ──
RUNNER_API_KEY=
OPENWA_ADMIN_API_KEY=

# ── OpenWA 8-line gateway (:2785) ──
OPENWA_OPERATOR_KEY=

# ── Google Master Inventory Sheet (service account) ──
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
# or file path variant:
# GOOGLE_SERVICE_ACCOUNT_KEY=/app/service-account-key.json

# ── Telegram intake bot ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_AGENT_GROUP_IDS=
TELEGRAM_GENERAL_GROUP_ID=
TELEGRAM_WEBHOOK_SECRET=

# ── Supabase (service role — NEVER expose client-side) ──
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Property Finder Atlas v1 ──
PROPERTY_FINDER_API_KEY=
PROPERTY_FINDER_API_SECRET=

# ── AI providers ──
GOOGLE_AI_API_KEY=
DEEPSEEK_API_KEY=

# ── Email / escalation ──
SENDGRID_API_KEY=

# ── GitHub fleet dispatch (fine-grained PAT, Actions: read+write) ──
FLEET_GITHUB_TOKEN=
