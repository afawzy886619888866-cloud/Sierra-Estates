# Sierra Estates — OpenWA Gateway Environment
# Copy to .env and fill in your values

# ── OpenWA Gateway ──────────────────────────────────────────────
OPENWA_PORT=3000
# Generate with: openssl rand -hex 32
OPENWA_ADMIN_API_KEY=change-me-admin-key
OPENWA_OPERATOR_KEY=change-me-operator-key
# wwebjs = whatsapp-web.js (Chromium, lower ban risk — recommended)
# baileys = lighter RAM, higher ban risk
OPENWA_ENGINE=wwebjs
# Max outbound messages per 60s window (anti-ban guardrail)
OPENWA_RATE_LIMIT=30

# ── Supabase (Authoritative DB) ─────────────────────────────────
SUPABASE_URL=https://gaxfqcietzoonlmatiot.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# ── Sierra Estates API ──────────────────────────────────────────
# Where OpenWA forwards incoming WA events
SE_API_URL=https://admin.sierra-estates.net
# HMAC secret for webhook auth (must match SBR_SECRET_KEY in Vercel)
SBR_SECRET_KEY=your-sbr-secret-key

# ── n8n Workflow Automation ─────────────────────────────────────
N8N_PORT=5678
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changeme-strong-password
WEBHOOK_URL=http://YOUR_EC2_IP:5678
N8N_EDITOR_BASE_URL=http://YOUR_EC2_IP:5678
N8N_API_KEY=your-n8n-api-key

# ── AI / LLM ────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key

# ── Property Finder ─────────────────────────────────────────────
PROPERTY_FINDER_WEBHOOK_SECRET=your-pf-webhook-secret

# ── Timezone ─────────────────────────────────────────────────────
TIMEZONE=Africa/Cairo

# ── Google Sheets (for gsheets-logger plugin) ───────────────────
# Inventory master sheet — all WA messages logged here automatically
INVENTORY_SHEET_ID=1g9GIcCM0slC5QplgzatZRxU46O_N4CR2jgDp9DeMYZk
INVENTORY_SHEET_GID=1127958606
