{
  "sql.defaultDatabaseType": "postgres",
  "files.associations": {
    "*.sql": "postgres"
  },
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "python.defaultInterpreterPath": "C:\\Users\\sierr\\AppData\\Local\\Programs\\Python\\Python313\\python.exe",
  "python.languageServer": "Jedi",
  "python.analysis.typeCheckingMode": "basic",
  "vscode-edge-devtools.webhint": false,
  "webhint.enable": false,
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/CVS": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/.turbo": true
  },
  "compilets.autoStart": true,
  "markdown.validate.enabled": true,
  "github-actions.workflows.validations.enabled": false,
  // Prevent the Red Hat YAML extension from validating workflow files against the
  // github-workflow JSON schema. That schema cannot statically resolve runtime secrets,
  // generating hundreds of false-positive "Context access might be invalid" warnings.
  // Setting the schema to an empty array disables schema-driven validation for these files.
  "yaml.schemas": {
    "https://json.schemastore.org/github-workflow.json": []
  },
  "yaml.schemaStore.enable": false
}