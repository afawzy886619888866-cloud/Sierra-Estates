{
  "sql.defaultDatabaseType": "postgres",
  "files.associations": {
    "*.sql": "postgres",
    "pnpm-lock.yaml": "text",
    "**/.github/workflows/*.yml": "yaml",
    "**/.github/workflows/*.yaml": "yaml",
    "**/.github/workflows/*": "yaml"
  },
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "python.defaultInterpreterPath": "C:\\Users\\sierr\\AppData\\Local\\Programs\\Python\\Python313\\python.exe",
  "python.languageServer": "Jedi",
  "python.analysis.typeCheckingMode": "basic",
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/CVS": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/.turbo": true
  },
  "markdown.validate.enabled": true,
  "github-actions.workflows.validations.enabled": false,
  "github-actions.workflows.validations.context.access": "ignore",
  "github-actions.workflows.validations.undefined.context": "ignore",
  "github-actions.workflows.validations.expression.validation": "ignore",
  "github-actions.workflows.validations.schema": false,
  "yaml.validate": false,
  "yaml.schemas": {},
  "yaml.schemaStore.enable": false,
  "tailwindCSS.includeLanguages": {
    "typescript": "javascript",
    "typescriptreact": "javascript"
  },
  "sqltools.useNodeRuntime": true,
  "search.exclude": {
    "**/node_modules": true,
    "**/.next": true,
    "**/.turbo": true,
    "**/dist": true,
    "**/coverage": true
  },
  "cSpell.ignoreRegExpList": [
    "[\\u0600-\\u06FF\\u0750-\\u077F\\u08A0-\\u08FF\\uFB50-\\uFDFF\\uFE70-\\uFEFF]+"
  ],
  "cSpell.ignorePaths": [
    "**/*.csv",
    "**/*.xlsx",
    "**/*.tsv",
    "**/public/downloads/**",
    "**/node_modules/**",
    "**/.next/**",
    "**/.turbo/**",
    "**/dist/**",
    "**/*.min.*"
  ],
