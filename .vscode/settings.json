{
  "sql.defaultDatabaseType": "postgres",
  "files.associations": {
    "*.sql": "postgres",
    "pnpm-lock.yaml": "text",
    "**/.github/workflows/*.yml": "yaml",
    "**/.github/workflows/*.yaml": "yaml",
    "**/.github/workflows/*": "yaml"
  },
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "python.languageServer": "Jedi",
  "python.analysis.typeCheckingMode": "basic",
  "compilets.autoStart": false,
  "compile-hero.disable-compile-files-on-did-save-code": true,
  "typescript.compileOnSave": false,
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/CVS": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/.turbo": true
  },
  "markdown.validate.enabled": true,
  "markdown.validate.referenceLinks.enabled": "ignore",
  "markdownlint.configFile": "${workspaceFolder}/.markdownlint.json",
  "css.lint.vendorPrefix": "ignore",
  "github-actions.workflows.validations.enabled": false,
  "github-actions.workflows.validations.context.access": "off",
  "github-actions.workflows.validations.undefined.context": "off",
  "github-actions.workflows.validations.expression.validation": "off",
  "github-actions.workflows.validations.schema": false,
  "yaml.validate": false,
  "yaml.schemas": {},
  "yaml.schemaStore.enable": false,
  "tailwindCSS.includeLanguages": {
    "typescript": "javascript",
    "typescriptreact": "javascript"
  },
  "sqltools.useNodeRuntime": true,
  "search.exclude": {
    "**/node_modules": true,
    "**/.next": true,
    "**/.turbo": true,
    "**/dist": true,
    "**/coverage": true
  },
  "cSpell.configFile": "${workspaceFolder}/cspell.json",
  "cSpell.words": [
    "Andrej",
    "ilike",
    "karpathy",
    "Karpathy",
    "pathing",
    "Postgrest",
    "serialisation",
    "unrequested",
    "upserted"
  ],
  "circuitpythonsync.cpbaseversion": "10",
  "circuitpythonsync.cpfullversion": "10.3.0",
  "circuitpythonsync.curlibtag": "20260901",
  "circuitpythonsync.doNotShowWelcome": true,
  "circuitpythonsync.drivepath": "",
  "rust-analyzer.cargo.target": "x86_64-pc-windows-gnu",
  "git.path": "C:\\Program Files\\Git\\cmd\\git.exe",
  "git.enabled": true,
  "git.autorefresh": true,
  "git.autoRepositoryDetection": true,
  "gitlens.git.path": "C:\\Program Files\\Git\\cmd\\git.exe",
  "gitlens.codeLens.enabled": true,
  "gitlens.currentLine.enabled": true,
  "gitlens.hovers.enabled": true,
  "gitlens.statusBar.enabled": true,
  "gitlens.showWelcomeOnInstall": false,
  "gitlens.showWhatsNewAfterUpgrades": false
}