{
  "sql.defaultDatabaseType": "postgres",
  "files.associations": {
    "*.sql": "postgres",
    "pnpm-lock.yaml": "text",
    "**/.github/workflows/*.yml": "yaml",
    "**/.github/workflows/*.yaml": "yaml",
    "**/.github/workflows/*": "yaml"
  },
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "python.languageServer": "Default",
  "python.analysis.typeCheckingMode": "basic",
  "compilets.autoStart": false,
  "compile-hero.disable-compile-files-on-did-save-code": true,
  "typescript.compileOnSave": false,
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/CVS": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/.turbo": true
  },
  "markdown.validate.enabled": true,
  "markdown.validate.referenceLinks.enabled": "ignore",
  "markdownlint.configFile": "${workspaceFolder}/.markdownlint.json",
  "css.lint.vendorPrefix": "ignore",
  "github-actions.workflows.validations.enabled": false,
  "github-actions.workflows.validations.context.access": "off",
  "github-actions.workflows.validations.undefined.context": "off",
  "github-actions.workflows.validations.expression.validation": "off",
  "github-actions.workflows.validations.schema": false,
  "github-actions.workflows.pinnedSecrets": [
    "CRON_SECRET",
    "VERCEL_TOKEN",
    "VERCEL_AUTH_TOKEN",
    "SUPABASE_ACCESS_TOKEN",
    "SUPABASE_DB_URL",
    "JIRA_BASE_URL",
    "JIRA_USER_EMAIL",
    "JIRA_API_TOKEN"
  ],
  "yaml.validate": false,
  "yaml.schemas": {},
  "yaml.schemaStore.enable": false,
  "tailwindCSS.includeLanguages": {
    "typescript": "javascript",
    "typescriptreact": "javascript"
  },
  "sqltools.useNodeRuntime": true,
  "search.exclude": {
    "**/node_modules": true,
    "**/.next": true,
    "**/.turbo": true,
    "**/dist": true,
    "**/coverage": true
  },
  "cSpell.configFile": "${workspaceFolder}/cspell.json",
  "cSpell.ignoreRegExpList": [
    "[\\u0600-\\u06FF\\u0750-\\u077F\\u08A0-\\u08FF\\uFB50-\\uFDFF\\uFE70-\\uFEFF]+"
  ],
  "cSpell.words": [
    "farida",
    "Namecheap",
    "namecheap",
    "Andrej",
    "authfail",
    "checkpointed",
    "claymorphism",
    "CLAYMORPHISM",
    "findstr",
    "hdrs",
    "ilike",
    "journalctl",
    "karpathy",
    "Karpathy",
    "nums",
    "paircode",
    "pathing",
    "Postgrest",
    "serialisation",
    "trycloudflare",
    "unrequested",
    "upserted",
    "knowledgebase",
    "descritpion",
    "pymath",
    "pgrep",
    "boostrapping",
    "Addy",
    "Osmani",
    "addyosmani",
    "wshobson",
    "asgeirtj",
    "localstack",
    "inventree",
    "InvenTree",
    "afawzy",
    "ahlan",
    "geolocated",
    "greenspine",
    "hydepark",
    "palmhills",
    "vpgk",
    "zedeast"
  ],
  "circuitpythonsync.cpbaseversion": "10",
  "circuitpythonsync.cpfullversion": "10.3.0",
  "circuitpythonsync.curlibtag": "20260901",
  "circuitpythonsync.doNotShowWelcome": true,
  "circuitpythonsync.drivepath": "",
  "rust-analyzer.cargo.target": "x86_64-pc-windows-gnu",
  "git.path": "C:\\Program Files\\Git\\cmd\\git.exe",
  "git.enabled": true,
  "git.autorefresh": true,
  "git.autoRepositoryDetection": true,
  "git.repositoryScanMaxDepth": 1,
  "git.ignoredRepositories": [
    "C:\\Users\\Sierr"
  ],
  "gitlens.git.path": "C:\\Program Files\\Git\\cmd\\git.exe",
  "gitlens.codeLens.enabled": true,
  "gitlens.currentLine.enabled": true,
  "gitlens.hovers.enabled": true,
  "gitlens.statusBar.enabled": true,
  "gitlens.showWelcomeOnInstall": false,
  "gitlens.showWhatsNewAfterUpgrades": false,
  "markdown.validate.ignoredLinks": [
    "#license--maintainers",
    "#scheduling-topology"
  ]
}
