{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python Debugger: Current File",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal"
    },

    {
      "name": "🚀 Next.js: Dev Server (sierra-estates-realty)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "sierra-estates-client-page",
        "dev"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "serverReadyAction": {
        "pattern": "- Local:.+(https?://.+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    },
    {
      "name": "⚡ Turbo: Dev (All Workspaces)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dev"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "🧪 Jest: Debug Current Test File",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/jest/bin/jest.js",
      "args": [
        "--runInBand",
        "--no-cache",
        "${file}"
      ],
      "cwd": "${workspaceFolder}/apps/sierra-estates-realty",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "sourceMaps": true
    },
    {
      "name": "🧪 Jest: Run All Tests",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/jest/bin/jest.js",
      "args": [
        "--runInBand",
        "--forceExit"
      ],
      "cwd": "${workspaceFolder}/apps/sierra-estates-realty",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "sourceMaps": true
    },
    {
      "name": "🎯 DeepSeek: Run Benchmark Harness",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "tsx",
        "${workspaceFolder}/scripts/run-harness.ts"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "🚀 Deploy: Verify Deployment Readiness",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "tsx",
        "${workspaceFolder}/scripts/verify-deploy-readiness.ts"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "🏠 Sync: PropertyFinder Catalog",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "tsx",
        "${workspaceFolder}/scripts/sync-propertyfinder.ts"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "📜 TSX / Node: Run Current Script",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "tsx",
        "${file}"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "🌐 Chrome: Launch (localhost:3000)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}/apps/sierra-estates-realty"
    },
    {
      "name": "🌐 Edge: Launch (localhost:3000)",
      "type": "msedge",
      "request": "launch",
      "version": "stable",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}/apps/sierra-estates-realty"
    }
  ],
  "compounds": [
    {
      "name": "🌟 Next.js: Full-Stack (Server + Chrome)",
      "configurations": [
        "🚀 Next.js: Dev Server (sierra-estates-realty)",
        "🌐 Chrome: Launch (localhost:3000)"
      ]
    },
    {
      "name": "🌟 Next.js: Full-Stack (Server + Edge)",
      "configurations": [
        "🚀 Next.js: Dev Server (sierra-estates-realty)",
        "🌐 Edge: Launch (localhost:3000)"
      ]
    }
  ]
}