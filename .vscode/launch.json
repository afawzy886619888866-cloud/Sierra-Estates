            "port": 3099,
            "localRoot": "${workspaceFolder}",
            "pause": true,
            "refProjects": []
        },
        


        {
            "name": "Attach to process",
            "type": "abl",
            "request": "attach",
            "hostname": "Host name or IP address of process to be debugged",
            "mode": "legacy",
            "port": 3099,
            "localRoot": "${workspaceFolder}",
            "pause": true,
            "refProjects": []
