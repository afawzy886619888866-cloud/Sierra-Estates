{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*compiling.*",
          "endsPattern": ".*compiled.*"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "label": "Start Dev Server"
    },
    {
      "type": "npm",
      "script": "test",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "label": "Run Tests"
    },
    {
      "type": "npm",
      "script": "type-check",
      "group": "build",
      "label": "Type-Check Workspace"
    },
    {
      "type": "npm",
      "script": "lint",
      "group": "build",
      "label": "Run Linter"
    }
  ]
}
